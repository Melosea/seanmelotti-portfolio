---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="border-b border-line bg-surface">
  <div class="container-page py-14 md:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 text-4xl text-ink-950 md:text-5xl">{title}</h1>
    {lede && <p class="mt-4 max-w-xl text-lg text-ink-500">{lede}</p>}
  </div>
</div>
