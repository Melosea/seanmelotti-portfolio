---
// Caption Studio — dev only. Injected by astro.config.mjs only when command === 'dev'.
// This file is NOT in src/pages/ and is never emitted in production builds.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Caption Studio</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0a0b0d;
        --surface: #141518;
        --surface2: #1e2024;
        --border: #2a2c32;
        --text: #e8eaed;
        --muted: #7c838e;
        --accent: #2f56d9;
        --accent-soft: #1a2d6e;
        --green: #0f6344;
        --green-soft: #e8f5ef;
        --warn: #7a4705;
        --warn-soft: #fdf3e4;
        --red-soft: #3d1a1a;
        --red: #f87171;
        --sans: "Inter Variable","Inter",system-ui,sans-serif;
        --mono: "JetBrains Mono Variable","JetBrains Mono",monospace;
        --header-h: 3.5rem;
      }

      html, body { height: 100%; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 14px; }

      .studio-layout {
        display: grid;
        grid-template-rows: var(--header-h) 1fr;
        grid-template-columns: 280px 1fr;
        height: 100vh;
      }

      .studio-header {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 1.25rem;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
      }

      .studio-header h1 { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

      .studio-sidebar {
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .studio-sidebar-header {
        padding: 1rem 1.25rem 0.75rem;
        border-bottom: 1px solid var(--border);
        font-size: 11px;
        font-family: var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .project-list { flex: 1; overflow-y: auto; padding: 0.5rem; }

      .project-btn {
        display: block; width: 100%; text-align: left;
        padding: 0.625rem 0.875rem; border-radius: 6px;
        border: 1px solid transparent; background: transparent;
        color: var(--text); cursor: pointer; font-size: 13px;
        font-family: var(--sans); transition: background 0.15s; margin-bottom: 2px;
      }
      .project-btn:hover { background: var(--surface2); }
      .project-btn.active { background: var(--accent-soft); border-color: var(--accent); color: #c7d3fa; }
      .project-btn .count { float: right; font-family: var(--mono); font-size: 11px; color: var(--muted); }

      .studio-main { overflow-y: auto; display: flex; flex-direction: column; }

      .toolbar {
        display: flex; align-items: center; gap: 0.75rem;
        padding: 0.75rem 1.25rem;
        background: var(--surface); border-bottom: 1px solid var(--border);
        flex-shrink: 0; flex-wrap: wrap; position: sticky; top: 0; z-index: 10;
      }

      .toolbar-group { display: flex; align-items: center; gap: 0.5rem; }
      .toolbar-sep { width: 1px; height: 20px; background: var(--border); }

      .btn {
        display: inline-flex; align-items: center; gap: 0.375rem;
        height: 30px; padding: 0 0.75rem; border-radius: 5px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--text); font-size: 12px; font-family: var(--sans);
        font-weight: 500; cursor: pointer; white-space: nowrap;
        transition: background 0.15s, border-color 0.15s;
      }
      .btn:hover { background: #2a2d34; border-color: #444; }
      .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn-primary:hover { background: #2545b4; border-color: #2545b4; }

      .save-status {
        font-size: 11px; font-family: var(--mono); padding: 3px 8px;
        border-radius: 4px; white-space: nowrap;
      }
      .save-status.saved { background: var(--green-soft); color: var(--green); }
      .save-status.unsaved { background: var(--warn-soft); color: var(--warn); }
      .save-status.saving { background: #1e2a3a; color: #60a5fa; }

      .seq-counter {
        font-size: 11px; font-family: var(--mono); padding: 3px 8px;
        border-radius: 4px; background: var(--surface2); color: var(--muted);
        white-space: nowrap;
      }
      .seq-counter.on-target { color: #4ade80; }

      .missing-alt-badge {
        font-size: 11px; font-family: var(--mono); padding: 3px 8px;
        border-radius: 4px; background: var(--red-soft); color: var(--red);
        white-space: nowrap; display: none;
      }
      .missing-alt-badge.visible { display: inline-block; }

      .preview-area {
        flex: 1; padding: 2rem 1.5rem;
        max-width: 860px; margin: 0 auto; width: 100%;
      }

      .header-field { margin-bottom: 2rem; }
      .field-label {
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.375rem;
        display: flex; align-items: center; gap: 0.5rem;
      }
      .char-count {
        font-size: 10px; font-family: var(--mono); padding: 1px 6px; border-radius: 3px;
        background: var(--surface2); color: var(--muted);
      }
      .char-count.warn { background: var(--warn-soft); color: var(--warn); }
      .word-count {
        font-size: 10px; font-family: var(--mono); padding: 1px 6px; border-radius: 3px;
        background: var(--surface2); color: var(--muted);
      }
      .word-count.warn { background: var(--warn-soft); color: var(--warn); }

      .header-input {
        width: 100%; padding: 0.625rem 0.75rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 6px; color: var(--text); font-size: 16px;
        font-family: var(--sans); font-weight: 560; line-height: 1.5;
        resize: none; min-height: 3rem; transition: border-color 0.15s;
      }
      .header-input:focus { outline: none; border-color: var(--accent); }

      /* Photo entries */
      .photo-list { display: flex; flex-direction: column; gap: 0; }

      .photo-entry {
        position: relative; padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
      }
      .photo-entry:first-child { border-top: 1px solid var(--border); }

      .photo-entry-inner { display: flex; flex-direction: column; gap: 0.75rem; }

      /* Top controls row */
      .photo-controls {
        display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
      }

      .master-idx {
        font-family: var(--mono); font-size: 10px; color: var(--muted);
        min-width: 28px; text-align: center; flex-shrink: 0;
      }

      /* Destination selector */
      .dest-select {
        font-size: 11px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.05em; padding: 2px 6px; border-radius: 4px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--muted); cursor: pointer; appearance: none;
        -webkit-appearance: none; min-width: 110px;
      }
      .dest-select:focus { outline: none; border-color: var(--accent); }
      .dest-select.dest-main { border-color: var(--accent); color: #c7d3fa; background: var(--accent-soft); }
      .dest-select.dest-gallery { border-color: #2d6b4a; color: #4ade80; background: #0d2a1d; }
      .dest-select.dest-cut { border-color: #555; color: #555; }

      /* Sequence position + up/down (only visible when dest=main) */
      .seq-controls {
        display: none; align-items: center; gap: 0.25rem;
      }
      .seq-controls.visible { display: flex; }
      .seq-pos-badge {
        font-family: var(--mono); font-size: 10px; color: #c7d3fa;
        background: var(--accent-soft); border: 1px solid var(--accent);
        padding: 1px 6px; border-radius: 3px; min-width: 36px; text-align: center;
      }
      .seq-btn {
        width: 22px; height: 22px; border-radius: 3px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--muted); cursor: pointer; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.1s;
      }
      .seq-btn:hover { background: #2a2d34; color: var(--text); }
      .seq-btn:disabled { opacity: 0.3; cursor: not-allowed; }

      /* Hero radio */
      .hero-label {
        display: flex; align-items: center; gap: 0.25rem;
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; padding: 2px 7px; border-radius: 4px;
        border: 1px solid var(--border); background: transparent;
        color: var(--muted); cursor: pointer; transition: all 0.15s;
        white-space: nowrap;
      }
      .hero-label input { display: none; }
      .hero-label:has(input:checked) {
        background: #1a3a1a; border-color: #1f5c30; color: #4ade80;
      }

      .photo-filename { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-left: auto; }

      /* Image wrapper */
      .photo-img-wrapper {
        width: 100%; background: var(--surface2); border-radius: 6px;
        overflow: hidden; border: 1px solid var(--border);
      }
      .photo-img-wrapper img {
        width: 100%; height: auto; display: block;
        max-height: 520px; object-fit: contain;
      }
      .photo-img-wrapper .img-placeholder {
        height: 180px; display: flex; align-items: center;
        justify-content: center; color: var(--muted);
        font-size: 12px; font-family: var(--mono);
      }

      /* Caption + alt inputs */
      .caption-row { display: flex; flex-direction: column; gap: 0.375rem; }

      .caption-field-label {
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--muted);
        display: flex; align-items: center; gap: 0.375rem;
      }

      .caption-input, .alt-input {
        width: 100%; padding: 0.45rem 0.65rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 5px; color: var(--text); font-size: 13px;
        font-family: var(--sans); line-height: 1.5;
        transition: border-color 0.15s;
        resize: none; overflow: hidden; min-height: 2.25rem;
        display: block; box-sizing: border-box;
      }
      .caption-input:focus, .alt-input:focus { outline: none; border-color: var(--accent); }
      .caption-input::placeholder, .alt-input::placeholder { color: var(--muted); }

      /* Per-photo saved indicator */
      .photo-save-indicator {
        font-size: 10px; font-family: var(--mono); padding: 1px 6px;
        border-radius: 3px; white-space: nowrap; flex-shrink: 0;
        opacity: 0; transition: opacity 0.3s;
      }
      .photo-save-indicator.dirty { background: var(--warn-soft); color: var(--warn); opacity: 1; }
      .photo-save-indicator.saved { background: #0d2a1d; color: #4ade80; opacity: 1; }

      /* Drag-and-drop */
      .photo-entry[draggable="true"] { cursor: grab; }
      .photo-entry[draggable="true"]:active { cursor: grabbing; }
      .photo-entry.drag-over { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 4px; }

      .alt-missing-warn {
        display: none; font-size: 10px; font-family: var(--mono);
        color: var(--red); margin-top: 0.25rem;
      }
      .alt-missing-warn.visible { display: block; }

      /* Greyed out when cut */
      .photo-entry.dest-cut .photo-img-wrapper { opacity: 0.3; }
      .photo-entry.dest-cut .caption-row { opacity: 0.4; pointer-events: none; }

      /* Empty state */
      .empty-state {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 0.75rem; color: var(--muted); font-size: 13px;
        padding: 3rem; text-align: center;
      }
      .empty-state h2 { font-size: 18px; color: var(--text); font-weight: 500; }

      .loading { text-align: center; padding: 3rem; color: var(--muted); font-family: var(--mono); font-size: 12px; }
    </style>
  </head>
  <body>
    <div class="studio-layout">
      <header class="studio-header">
        <h1>Caption Studio</h1>
        <div id="toolbar" style="display:none" class="toolbar-group">
          <button class="btn btn-primary" id="btn-export" type="button">Export MDX</button>
          <span id="save-status" class="save-status saved">Saved</span>
        </div>
      </header>

      <aside class="studio-sidebar">
        <div class="studio-sidebar-header">Projects</div>
        <div class="project-list" id="project-list">
          <div class="loading">Loading…</div>
        </div>
      </aside>

      <main class="studio-main" id="studio-main">
        <div class="empty-state" id="empty-state">
          <h2>Select a project</h2>
          <p>Choose a project from the sidebar to start editing captions.</p>
        </div>
      </main>
    </div>

    <script type="module">
      // ─── State ──────────────────────────────────────────────────────────────
      // state.photos = master list, EXIF order (immutable sort)
      // state.seqOrder = ordered array of filenames currently in main sequence
      // state.heroFilename = filename of hero, or null
      let currentSlug = null;
      let state = null;
      let saveTimer = null;
      let isDirty = false;
      let dirtyPhotos = new Set(); // filenames with unsaved changes
      let dragSrcFn = null; // filename being dragged

      const projectList = document.getElementById('project-list');
      const studioMain = document.getElementById('studio-main');
      const emptyState = document.getElementById('empty-state');
      const toolbar = document.getElementById('toolbar');

      // ─── API ────────────────────────────────────────────────────────────────
      async function apiGet(path) {
        const r = await fetch(`/api/studio${path}`);
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      }
      async function apiPost(path, body) {
        const r = await fetch(`/api/studio${path}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      }

      // ─── Load projects list ─────────────────────────────────────────────────
      async function loadProjects() {
        const { projects } = await apiGet('/projects');
        projectList.innerHTML = '';
        if (!projects.length) {
          projectList.innerHTML = '<div class="loading">No photo folders found.</div>';
          return;
        }
        for (const p of projects) {
          const btn = document.createElement('button');
          btn.className = 'project-btn';
          btn.dataset.slug = p.slug;
          btn.innerHTML = `${p.slug} <span class="count">${p.photoCount}</span>`;
          btn.addEventListener('click', () => loadProject(p.slug));
          projectList.appendChild(btn);
        }
      }

      // ─── Load project ───────────────────────────────────────────────────────
      async function loadProject(slug) {
        currentSlug = slug;
        document.querySelectorAll('.project-btn').forEach(b => b.classList.toggle('active', b.dataset.slug === slug));
        studioMain.innerHTML = '<div class="loading">Loading…</div>';
        toolbar.style.display = '';

        const { photos: photoFiles } = await apiGet(`/photos/${slug}`);

        let saved = null;
        try { saved = await apiGet(`/sidecar/${slug}`); } catch {}

        // Build master list from disk order (EXIF-sorted filenames from API)
        const masterPhotos = photoFiles.map(filename => {
          const existing = saved?.photos?.find(p => p.filename === filename);
          return {
            filename,
            caption: existing?.caption ?? '',
            alt: existing?.alt ?? '',
            destination: existing?.destination ?? 'unassigned',
          };
        });
        // Add any saved photos that aren't on disk anymore (just skip them)

        state = {
          // Spread saved first so metadata fields (tags, vehicle, date, type, etc.) are preserved
          ...(saved ?? {}),
          slug,
          title: saved?.title ?? slugToTitle(slug),
          summary: saved?.summary ?? '',
          heroFilename: saved?.heroFilename ?? null,
          specStrip: saved?.specStrip ?? [],
          photos: masterPhotos,
          seqOrder: (saved?.seqOrder ?? []).filter(fn => masterPhotos.some(p => p.filename === fn)),
        };

        // Ensure seqOrder only contains filenames currently marked as main
        // (dest may have changed since last save)
        state.seqOrder = state.seqOrder.filter(fn => {
          const p = state.photos.find(p => p.filename === fn);
          return p && p.destination === 'main';
        });
        // Append any main photos not in seqOrder
        for (const p of state.photos) {
          if (p.destination === 'main' && !state.seqOrder.includes(p.filename)) {
            state.seqOrder.push(p.filename);
          }
        }

        isDirty = false;
        renderStudio();
        setSaveStatus('saved');
      }

      function slugToTitle(slug) {
        return slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }

      // ─── Render studio ──────────────────────────────────────────────────────
      function renderStudio() {
        if (!state) return;
        emptyState.style.display = 'none';

        const seqCount = state.seqOrder.length;
        const missingAlt = state.photos.filter(p =>
          (p.destination === 'main' || p.destination === 'gallery') && !p.alt.trim()
        ).length;
        const captionedCount = state.photos.filter(p => p.caption.trim()).length;
        const totalCount = state.photos.length;
        const wordCount = countWords(state.summary);
        const warnClass = wordCount > 35 ? 'warn' : '';
        const seqOnTarget = seqCount >= 12 && seqCount <= 24;

        studioMain.innerHTML = `
          <div class="toolbar">
            <div class="toolbar-group">
              <span style="font-size:11px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:0.06em">${state.slug}</span>
            </div>
            <div class="toolbar-sep"></div>
            <span class="seq-counter${seqOnTarget ? ' on-target' : ''}" id="seq-counter">
              Seq: ${seqCount} <span style="opacity:0.5">/ target 12–24</span>
            </span>
            <span class="seq-counter" id="captioned-counter" style="min-width:96px">
              ${captionedCount} <span style="opacity:0.5">/ ${totalCount} captioned</span>
            </span>
            <span class="missing-alt-badge${missingAlt > 0 ? ' visible' : ''}" id="missing-alt-badge">
              ${missingAlt} missing alt
            </span>
            <div class="toolbar-sep"></div>
            <div class="toolbar-group">
              <button class="btn btn-primary" id="btn-export">Export MDX</button>
              <span id="save-status" class="save-status saved">Saved</span>
            </div>
          </div>
          <div class="preview-area">
            <div class="header-field">
              <div class="field-label">
                Summary / Header
                <span class="word-count ${warnClass}" id="word-count">${wordCount}/35 words</span>
              </div>
              <textarea
                class="header-input" id="summary-input" rows="2"
                placeholder="~30-word project summary for employers scanning fast…"
              >${escHtml(state.summary)}</textarea>
            </div>

            <div class="photo-list" id="photo-list">
              ${state.photos.map((photo, i) => renderPhotoEntry(photo, i)).join('')}
            </div>
          </div>
        `;

        bindEvents();
      }

      function renderPhotoEntry(photo, masterIdx) {
        const imgSrc = `/photos/${currentSlug}/${photo.filename}`;
        const seqPos = state.seqOrder.indexOf(photo.filename);
        const isInSeq = seqPos >= 0;
        const isHero = state.heroFilename === photo.filename;
        const destClass = `dest-${photo.destination}`;
        const captionLen = photo.caption.length;
        const altLen = photo.alt.length;
        const captionWarn = captionLen > 90 ? 'warn' : '';
        const altMissing = (photo.destination === 'main' || photo.destination === 'gallery') && !photo.alt.trim();
        const seqFirst = isInSeq && seqPos === 0;
        const seqLast = isInSeq && seqPos === state.seqOrder.length - 1;

        return `
          <div class="photo-entry ${destClass}" data-filename="${escHtml(photo.filename)}" data-masteridx="${masterIdx}" draggable="true">
            <div class="photo-entry-inner">
              <div class="photo-controls">
                <span class="master-idx">#${masterIdx + 1}</span>

                <select class="dest-select ${destClass}" data-filename="${escHtml(photo.filename)}" aria-label="Destination">
                  <option value="unassigned"${photo.destination === 'unassigned' ? ' selected' : ''}>Unassigned</option>
                  <option value="main"${photo.destination === 'main' ? ' selected' : ''}>Main sequence</option>
                  <option value="gallery"${photo.destination === 'gallery' ? ' selected' : ''}>Gallery</option>
                  <option value="cut"${photo.destination === 'cut' ? ' selected' : ''}>Cut</option>
                </select>

                <div class="seq-controls${isInSeq ? ' visible' : ''}">
                  <span class="seq-pos-badge">#${isInSeq ? seqPos + 1 : '—'}</span>
                  <button class="seq-btn" data-action="seq-up" data-filename="${escHtml(photo.filename)}"
                    ${seqFirst ? 'disabled' : ''} title="Move earlier in sequence">↑</button>
                  <button class="seq-btn" data-action="seq-down" data-filename="${escHtml(photo.filename)}"
                    ${seqLast ? 'disabled' : ''} title="Move later in sequence">↓</button>
                </div>

                <label class="hero-label" title="Set as hero image">
                  <input type="radio" name="hero-radio" value="${escHtml(photo.filename)}"${isHero ? ' checked' : ''} />
                  ${isHero ? '★ Hero' : '☆ Hero'}
                </label>

                <span class="photo-filename">${escHtml(photo.filename)}</span>
              </div>

              <div class="photo-img-wrapper">
                <img src="${imgSrc}" alt="${escHtml(photo.alt || photo.filename)}"
                     loading="lazy"
                     onerror="this.parentElement.innerHTML='<div class=\\'img-placeholder\\'>Image not found</div>'" />
              </div>

              <div class="caption-row">
                <div>
                  <div class="caption-field-label">
                    Caption
                    <span class="char-count ${captionWarn}" id="cap-count-${masterIdx}">${captionLen}/90</span>
                    <span class="photo-save-indicator" id="save-ind-${masterIdx}"></span>
                  </div>
                  <textarea
                    class="caption-input"
                    data-filename="${escHtml(photo.filename)}"
                    data-field="caption"
                    placeholder="What's happening in this photo"
                    maxlength="120"
                    rows="1"
                    aria-label="Caption for ${escHtml(photo.filename)}"
                  >${escHtml(photo.caption)}</textarea>
                </div>
                <div>
                  <div class="caption-field-label">
                    Alt text
                    <span class="char-count" id="alt-count-${masterIdx}">${altLen}/125</span>
                  </div>
                  <textarea
                    class="alt-input"
                    data-filename="${escHtml(photo.filename)}"
                    data-field="alt"
                    placeholder="Literal description of what is visible"
                    maxlength="150"
                    rows="1"
                    aria-label="Alt text for ${escHtml(photo.filename)}"
                  >${escHtml(photo.alt)}</textarea>
                  <div class="alt-missing-warn${altMissing ? ' visible' : ''}">
                    ⚠ Alt text required for export
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }

      // ─── Bind all events (called after innerHTML write) ─────────────────────
      function bindEvents() {
        // Export button
        document.getElementById('btn-export')?.addEventListener('click', handleExport);

        // Summary
        const summaryInput = document.getElementById('summary-input');
        if (summaryInput) {
          summaryInput.addEventListener('input', () => {
            state.summary = summaryInput.value;
            const wc = countWords(state.summary);
            const wcEl = document.getElementById('word-count');
            if (wcEl) { wcEl.textContent = `${wc}/35 words`; wcEl.className = `word-count${wc > 35 ? ' warn' : ''}`; }
            markDirty();
          });
        }

        // Destination dropdowns
        document.querySelectorAll('.dest-select').forEach(sel => {
          sel.addEventListener('change', () => {
            const fn = sel.dataset.filename;
            const newDest = sel.value;
            const photo = state.photos.find(p => p.filename === fn);
            if (!photo) return;
            const oldDest = photo.destination;
            photo.destination = newDest;

            if (oldDest === 'main' && newDest !== 'main') {
              state.seqOrder = state.seqOrder.filter(f => f !== fn);
            }
            if (newDest === 'main' && !state.seqOrder.includes(fn)) {
              state.seqOrder.push(fn);
            }

            markDirty();
            renderStudio(); // re-render for seq counter + styling
          });
        });

        // Up/down sequence buttons
        document.querySelectorAll('[data-action="seq-up"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const fn = btn.dataset.filename;
            const idx = state.seqOrder.indexOf(fn);
            if (idx <= 0) return;
            [state.seqOrder[idx - 1], state.seqOrder[idx]] = [state.seqOrder[idx], state.seqOrder[idx - 1]];
            markDirty();
            renderStudio();
          });
        });
        document.querySelectorAll('[data-action="seq-down"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const fn = btn.dataset.filename;
            const idx = state.seqOrder.indexOf(fn);
            if (idx < 0 || idx >= state.seqOrder.length - 1) return;
            [state.seqOrder[idx], state.seqOrder[idx + 1]] = [state.seqOrder[idx + 1], state.seqOrder[idx]];
            markDirty();
            renderStudio();
          });
        });

        // Hero radio
        document.querySelectorAll('input[name="hero-radio"]').forEach(radio => {
          radio.addEventListener('change', () => {
            if (radio.checked) {
              state.heroFilename = radio.value;
              markDirty();
              // Update labels without full re-render
              document.querySelectorAll('.hero-label').forEach(lbl => {
                const r = lbl.querySelector('input');
                lbl.lastChild.textContent = r?.checked ? '★ Hero' : '☆ Hero';
              });
            }
          });
        });

        // Caption / alt inputs — delegate by field
        const photoList = document.getElementById('photo-list');
        if (photoList) {
          photoList.addEventListener('input', e => {
            const input = e.target;
            if (!input.dataset.filename || !input.dataset.field) return;
            const fn = input.dataset.filename;
            const field = input.dataset.field;
            const photo = state.photos.find(p => p.filename === fn);
            if (!photo) return;
            photo[field] = input.value;

            // Update char counter inline
            const masterIdx = state.photos.indexOf(photo);
            if (field === 'caption') {
              const el = document.getElementById(`cap-count-${masterIdx}`);
              if (el) { const l = input.value.length; el.textContent = `${l}/90`; el.className = `char-count${l > 90 ? ' warn' : ''}`; }
              updateCaptionedCounter();
            } else if (field === 'alt') {
              const el = document.getElementById(`alt-count-${masterIdx}`);
              if (el) { el.textContent = `${input.value.length}/125`; }
              // Toggle missing alt warning
              const row = input.closest('.photo-entry');
              const warn = row?.querySelector('.alt-missing-warn');
              if (warn) {
                const p = state.photos.find(p => p.filename === fn);
                const needs = p && (p.destination === 'main' || p.destination === 'gallery');
                warn.classList.toggle('visible', needs && !input.value.trim());
              }
              // Update global missing count
              updateMissingAltBadge();
            }

            markDirty(fn);
          });

          // Keyboard: tab from caption → alt → next photo's caption
          photoList.addEventListener('keydown', e => {
            if (e.key !== 'Tab' || e.shiftKey) return;
            const input = e.target;
            if (!input.dataset.filename || !input.dataset.field) return;
            if (input.dataset.field === 'caption') {
              e.preventDefault();
              const fn = input.dataset.filename;
              const row = input.closest('.photo-entry');
              const altInput = row?.querySelector('.alt-input');
              if (altInput) altInput.focus();
            } else if (input.dataset.field === 'alt') {
              e.preventDefault();
              const fn = input.dataset.filename;
              const masterIdx = state.photos.findIndex(p => p.filename === fn);
              const nextIdx = masterIdx + 1;
              if (nextIdx < state.photos.length) {
                const nextFn = state.photos[nextIdx].filename;
                const nextCaption = photoList.querySelector(`[data-filename="${nextFn}"][data-field="caption"]`);
                if (nextCaption) nextCaption.focus();
              }
            }
          });

          // Auto-grow textareas
          photoList.querySelectorAll('.caption-input, .alt-input').forEach(ta => {
            const grow = () => { ta.style.height = ''; ta.style.height = ta.scrollHeight + 'px'; };
            ta.addEventListener('input', grow);
            grow(); // set initial height
          });
        }

        // ─── Drag-and-drop reorder ────────────────────────────────────────────
        const photoList2 = document.getElementById('photo-list');
        if (photoList2) {
          photoList2.addEventListener('dragstart', e => {
            const entry = e.target.closest('.photo-entry');
            if (!entry) return;
            dragSrcFn = entry.dataset.filename;
            e.dataTransfer.effectAllowed = 'move';
          });
          photoList2.addEventListener('dragover', e => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const entry = e.target.closest('.photo-entry');
            photoList2.querySelectorAll('.photo-entry').forEach(el => el.classList.remove('drag-over'));
            if (entry && entry.dataset.filename !== dragSrcFn) entry.classList.add('drag-over');
          });
          photoList2.addEventListener('dragleave', e => {
            const entry = e.target.closest('.photo-entry');
            if (entry) entry.classList.remove('drag-over');
          });
          photoList2.addEventListener('drop', e => {
            e.preventDefault();
            photoList2.querySelectorAll('.photo-entry').forEach(el => el.classList.remove('drag-over'));
            const entry = e.target.closest('.photo-entry');
            if (!entry || !dragSrcFn || entry.dataset.filename === dragSrcFn) return;
            const targetFn = entry.dataset.filename;
            const srcIdx = state.photos.findIndex(p => p.filename === dragSrcFn);
            const dstIdx = state.photos.findIndex(p => p.filename === targetFn);
            if (srcIdx < 0 || dstIdx < 0) return;
            // Move src photo to dst position in master list
            const [moved] = state.photos.splice(srcIdx, 1);
            state.photos.splice(dstIdx, 0, moved);
            // Keep seqOrder intact (filenames don't change, just master display order)
            markDirty();
            renderStudio();
            dragSrcFn = null;
          });
          photoList2.addEventListener('dragend', () => {
            photoList2.querySelectorAll('.photo-entry').forEach(el => el.classList.remove('drag-over'));
            dragSrcFn = null;
          });
        }
      }

      function updateMissingAltBadge() {
        const count = state.photos.filter(p =>
          (p.destination === 'main' || p.destination === 'gallery') && !p.alt.trim()
        ).length;
        const badge = document.getElementById('missing-alt-badge');
        if (badge) {
          badge.textContent = `${count} missing alt`;
          badge.classList.toggle('visible', count > 0);
        }
      }

      function updateCaptionedCounter() {
        const captioned = state.photos.filter(p => p.caption.trim()).length;
        const el = document.getElementById('captioned-counter');
        if (el) {
          el.innerHTML = `${captioned} <span style="opacity:0.5">/ ${state.photos.length} captioned</span>`;
        }
      }

      // ─── Save / autosave ────────────────────────────────────────────────────
      function markDirty(filename) {
        isDirty = true;
        if (filename) {
          dirtyPhotos.add(filename);
          const masterIdx = state.photos.findIndex(p => p.filename === filename);
          const ind = document.getElementById(`save-ind-${masterIdx}`);
          if (ind) { ind.textContent = '● unsaved'; ind.className = 'photo-save-indicator dirty'; }
        }
        setSaveStatus('unsaved');
        clearTimeout(saveTimer);
        saveTimer = setTimeout(autoSave, 1500);
      }

      function setSaveStatus(s) {
        const el = document.getElementById('save-status');
        if (!el) return;
        el.className = `save-status ${s}`;
        el.textContent = s === 'saved' ? 'Saved' : s === 'unsaved' ? '● Unsaved' : 'Saving…';
      }

      async function autoSave() {
        if (!state || !isDirty) return;
        setSaveStatus('saving');
        try {
          await apiPost(`/sidecar/${state.slug}`, state);
          isDirty = false;
          // Flash per-photo indicators as saved then fade out
          const saved = Array.from(dirtyPhotos);
          dirtyPhotos.clear();
          for (const fn of saved) {
            const masterIdx = state.photos.findIndex(p => p.filename === fn);
            const ind = document.getElementById(`save-ind-${masterIdx}`);
            if (ind) {
              ind.textContent = '✓ saved';
              ind.className = 'photo-save-indicator saved';
              setTimeout(() => { if (ind) ind.className = 'photo-save-indicator'; }, 2500);
            }
          }
          setSaveStatus('saved');
        } catch (e) {
          setSaveStatus('unsaved');
          console.error('Save failed:', e);
        }
      }

      window.addEventListener('beforeunload', e => {
        if (isDirty) { autoSave(); e.preventDefault(); e.returnValue = ''; }
      });

      // ─── Export ─────────────────────────────────────────────────────────────
      async function handleExport() {
        if (!state) return;
        await autoSave();
        try {
          const r = await fetch('/api/studio/export', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: state.slug }),
          });
          const data = await r.json();
          if (data.ok) { alert(`Exported to ${data.path}`); }
          else { alert(`Export failed: ${data.error}`); }
        } catch {
          alert(`Save complete. Run:\n  node scripts/export-mdx.mjs ${state.slug}`);
        }
      }

      // ─── Helpers ────────────────────────────────────────────────────────────
      function countWords(s) { return s.trim() ? s.trim().split(/\s+/).length : 0; }

      function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // ─── Boot ───────────────────────────────────────────────────────────────
      loadProjects();
    </script>
  </body>
</html>
