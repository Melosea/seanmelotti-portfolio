---
// Caption Studio — dev only. Injected by astro.config.mjs only when command === 'dev'.
// This file is NOT in src/pages/ and is never emitted in production builds.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Caption Studio</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #0a0b0d;
        --surface: #141518;
        --surface2: #1e2024;
        --border: #2a2c32;
        --text: #e8eaed;
        --muted: #7c838e;
        --accent: #2f56d9;
        --accent-soft: #1a2d6e;
        --green: #0f6344;
        --green-soft: #e8f5ef;
        --warn: #7a4705;
        --warn-soft: #fdf3e4;
        --sans: "Inter Variable","Inter",system-ui,sans-serif;
        --mono: "JetBrains Mono Variable","JetBrains Mono",monospace;
        --header-h: 3.5rem;
      }

      html, body { height: 100%; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 14px; }

      /* ── Layout ── */
      .studio-layout {
        display: grid;
        grid-template-rows: var(--header-h) 1fr;
        grid-template-columns: 280px 1fr;
        height: 100vh;
      }

      .studio-header {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 1.25rem;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
      }

      .studio-header h1 { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

      .studio-sidebar {
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .studio-sidebar-header {
        padding: 1rem 1.25rem 0.75rem;
        border-bottom: 1px solid var(--border);
        font-size: 11px;
        font-family: var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .project-list { flex: 1; overflow-y: auto; padding: 0.5rem; }

      .project-btn {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.625rem 0.875rem;
        border-radius: 6px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        font-size: 13px;
        font-family: var(--sans);
        transition: background 0.15s;
        margin-bottom: 2px;
      }
      .project-btn:hover { background: var(--surface2); }
      .project-btn.active { background: var(--accent-soft); border-color: var(--accent); color: #c7d3fa; }
      .project-btn .count { float: right; font-family: var(--mono); font-size: 11px; color: var(--muted); }

      .studio-main {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }

      /* ── Toolbar ── */
      .toolbar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.25rem;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        flex-wrap: wrap;
      }

      .toolbar-group { display: flex; align-items: center; gap: 0.5rem; }
      .toolbar-sep { width: 1px; height: 20px; background: var(--border); }

      .btn {
        display: inline-flex; align-items: center; gap: 0.375rem;
        height: 30px; padding: 0 0.75rem; border-radius: 5px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--text); font-size: 12px; font-family: var(--sans);
        font-weight: 500; cursor: pointer; white-space: nowrap;
        transition: background 0.15s, border-color 0.15s;
      }
      .btn:hover { background: #2a2d34; border-color: #444; }
      .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn-primary:hover { background: #2545b4; border-color: #2545b4; }
      .btn-danger { background: #3d1a1a; border-color: #6b2828; color: #f87171; }

      .save-status {
        font-size: 11px; font-family: var(--mono); padding: 3px 8px;
        border-radius: 4px; white-space: nowrap;
      }
      .save-status.saved { background: var(--green-soft); color: var(--green); }
      .save-status.unsaved { background: var(--warn-soft); color: var(--warn); }
      .save-status.saving { background: #1e2a3a; color: #60a5fa; }

      /* ── Preview area ── */
      .preview-area {
        flex: 1;
        padding: 2rem 1.5rem;
        max-width: 820px;
        margin: 0 auto;
        width: 100%;
      }

      /* Header field */
      .header-field { margin-bottom: 2.5rem; }
      .field-label {
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.375rem;
        display: flex; align-items: center; gap: 0.5rem;
      }
      .word-count {
        font-size: 10px; font-family: var(--mono);
        padding: 1px 6px; border-radius: 3px;
        background: var(--surface2); color: var(--muted);
      }
      .word-count.warn { background: var(--warn-soft); color: var(--warn); }

      .header-input {
        width: 100%; padding: 0.625rem 0.75rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 6px; color: var(--text); font-size: 16px;
        font-family: var(--sans); font-weight: 560; line-height: 1.5;
        resize: none; min-height: 3rem;
        transition: border-color 0.15s;
      }
      .header-input:focus { outline: none; border-color: var(--accent); }

      /* Photo entries */
      .photo-list { display: flex; flex-direction: column; gap: 0; }

      .photo-entry {
        position: relative;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--border);
      }
      .photo-entry:first-child { border-top: 1px solid var(--border); }
      .photo-entry.dragging { opacity: 0.4; }
      .photo-entry.drag-over { background: var(--accent-soft); border-radius: 6px; }

      .photo-entry-inner {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
      }

      .photo-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.375rem;
      }

      .drag-handle {
        cursor: grab;
        color: var(--muted);
        padding: 4px;
        border-radius: 4px;
        border: none;
        background: transparent;
        font-size: 14px;
        line-height: 1;
        flex-shrink: 0;
      }
      .drag-handle:active { cursor: grabbing; }
      .drag-handle:hover { background: var(--surface2); }

      .order-badge {
        font-family: var(--mono); font-size: 10px; color: var(--muted);
        width: 28px; text-align: center;
      }

      .cover-btn {
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; padding: 2px 7px; border-radius: 4px;
        border: 1px solid var(--border); background: transparent;
        color: var(--muted); cursor: pointer; transition: all 0.15s;
      }
      .cover-btn.is-cover { background: #1a3a1a; border-color: #1f5c30; color: #4ade80; }
      .cover-btn:not(.is-cover):hover { border-color: var(--muted); }

      .photo-filename { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-left: auto; }

      .photo-img-wrapper {
        width: 100%;
        background: var(--surface2);
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--border);
      }
      .photo-img-wrapper img {
        width: 100%;
        height: auto;
        display: block;
        max-height: 600px;
        object-fit: contain;
      }
      .photo-img-wrapper .img-placeholder {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: 12px;
        font-family: var(--mono);
      }

      .caption-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 5px;
        color: var(--text);
        font-size: 13px;
        font-family: var(--sans);
        line-height: 1.5;
        transition: border-color 0.15s;
      }
      .caption-input:focus { outline: none; border-color: var(--accent); }
      .caption-input::placeholder { color: var(--muted); }

      /* Empty state */
      .empty-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        color: var(--muted);
        font-size: 13px;
        padding: 3rem;
        text-align: center;
      }
      .empty-state h2 { font-size: 18px; color: var(--text); font-weight: 500; }

      .loading {
        text-align: center; padding: 3rem; color: var(--muted);
        font-family: var(--mono); font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="studio-layout">
      <!-- Header -->
      <header class="studio-header">
        <h1>Caption Studio</h1>
        <div id="toolbar" style="display:none" class="toolbar-group">
          <button class="btn btn-primary" id="btn-export" type="button">Export MDX</button>
          <span id="save-status" class="save-status saved">Saved</span>
        </div>
      </header>

      <!-- Sidebar: project list -->
      <aside class="studio-sidebar">
        <div class="studio-sidebar-header">Projects</div>
        <div class="project-list" id="project-list">
          <div class="loading">Loading...</div>
        </div>
      </aside>

      <!-- Main: toolbar + preview -->
      <main class="studio-main" id="studio-main">
        <div class="empty-state" id="empty-state">
          <h2>Select a project</h2>
          <p>Choose a project from the sidebar to start adding captions.</p>
        </div>
      </main>
    </div>

    <script type="module">
      // ─── State ─────────────────────────────────────────────────────────────
      let currentSlug = null;
      let state = null; // { slug, title, summary, photos: [{filename, caption, isCover}] }
      let saveTimer = null;
      let isDirty = false;

      // ─── DOM refs ──────────────────────────────────────────────────────────
      const projectList = document.getElementById('project-list');
      const studioMain = document.getElementById('studio-main');
      const emptyState = document.getElementById('empty-state');
      const toolbar = document.getElementById('toolbar');
      const saveStatus = document.getElementById('save-status');
      const btnExport = document.getElementById('btn-export');

      // ─── API helpers ───────────────────────────────────────────────────────
      async function apiGet(path) {
        const r = await fetch(`/api/studio${path}`);
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      }
      async function apiPost(path, body) {
        const r = await fetch(`/api/studio${path}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      }

      // ─── Load projects ─────────────────────────────────────────────────────
      async function loadProjects() {
        const { projects } = await apiGet('/projects');
        projectList.innerHTML = '';
        if (projects.length === 0) {
          projectList.innerHTML = '<div class="loading">No photo folders found.<br>Run scripts/prepare-photos.py first.</div>';
          return;
        }
        for (const p of projects) {
          const btn = document.createElement('button');
          btn.className = 'project-btn';
          btn.dataset.slug = p.slug;
          btn.innerHTML = `${p.slug} <span class="count">${p.photoCount}</span>`;
          btn.addEventListener('click', () => loadProject(p.slug));
          projectList.appendChild(btn);
        }
      }

      // ─── Load project ──────────────────────────────────────────────────────
      async function loadProject(slug) {
        currentSlug = slug;
        document.querySelectorAll('.project-btn').forEach(b => b.classList.toggle('active', b.dataset.slug === slug));
        studioMain.innerHTML = '<div class="loading">Loading...</div>';
        toolbar.style.display = '';

        // Fetch photo list
        const { photos: photoFiles, manifest } = await apiGet(`/photos/${slug}`);

        // Try to load saved sidecar
        let saved = null;
        try { saved = await apiGet(`/sidecar/${slug}`); } catch {}

        // Build state
        state = {
          slug,
          title: saved?.title ?? slugToTitle(slug),
          summary: saved?.summary ?? '',
          photos: photoFiles.map((filename, i) => {
            const existing = saved?.photos?.find(p => p.filename === filename);
            return existing ?? { filename, caption: '', isCover: i === 0 };
          }),
        };

        // Respect saved photo order if it exists
        if (saved?.photos) {
          const ordered = [];
          for (const sp of saved.photos) {
            const found = state.photos.find(p => p.filename === sp.filename);
            if (found) ordered.push(found);
          }
          // Append any new photos not in saved order
          for (const p of state.photos) {
            if (!ordered.find(o => o.filename === p.filename)) ordered.push(p);
          }
          state.photos = ordered;
        }

        isDirty = false;
        renderStudio();
        setSaveStatus('saved');
      }

      function slugToTitle(slug) {
        return slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }

      // ─── Render studio ─────────────────────────────────────────────────────
      function renderStudio() {
        if (!state) return;
        emptyState.style.display = 'none';

        const wordCount = countWords(state.summary);
        const warnClass = wordCount > 35 ? 'warn' : '';

        studioMain.innerHTML = `
          <div class="toolbar">
            <div class="toolbar-group">
              <span style="font-size:11px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:0.06em">${state.slug}</span>
            </div>
            <div class="toolbar-sep"></div>
            <div class="toolbar-group">
              <button class="btn btn-primary" id="btn-export">Export MDX</button>
              <span id="save-status" class="save-status saved">Saved</span>
            </div>
          </div>
          <div class="preview-area">
            <div class="header-field">
              <div class="field-label">
                Project Summary / Header
                <span class="word-count ${warnClass}" id="word-count">${wordCount}/35 words</span>
              </div>
              <textarea
                class="header-input"
                id="summary-input"
                rows="3"
                placeholder="~30-word project summary for employers scanning fast…"
              >${escHtml(state.summary)}</textarea>
            </div>

            <div class="photo-list" id="photo-list">
              ${state.photos.map((photo, i) => renderPhotoEntry(photo, i)).join('')}
            </div>
          </div>
        `;

        // Re-bind toolbar buttons
        document.getElementById('btn-export')?.addEventListener('click', handleExport);

        // Summary input
        const summaryInput = document.getElementById('summary-input');
        summaryInput.addEventListener('input', () => {
          state.summary = summaryInput.value;
          const wc = countWords(state.summary);
          const wcEl = document.getElementById('word-count');
          wcEl.textContent = `${wc}/35 words`;
          wcEl.className = `word-count${wc > 35 ? ' warn' : ''}`;
          markDirty();
        });
        summaryInput.addEventListener('keydown', e => { if (e.key === 'Tab') { e.preventDefault(); } });

        // Caption inputs
        document.querySelectorAll('.caption-input').forEach(input => {
          input.addEventListener('input', () => {
            const idx = parseInt(input.dataset.idx);
            state.photos[idx].caption = input.value;
            markDirty();
          });
        });

        // Cover buttons
        document.querySelectorAll('.cover-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.dataset.idx);
            state.photos.forEach((p, i) => { p.isCover = (i === idx); });
            refreshCoverButtons();
            markDirty();
          });
        });

        // Drag reorder
        setupDragReorder();
      }

      function renderPhotoEntry(photo, i) {
        const imgSrc = `/photos/${currentSlug}/${photo.filename}`;
        const isCover = photo.isCover;
        return `
          <div class="photo-entry" data-idx="${i}" draggable="true">
            <div class="photo-entry-inner">
              <div class="photo-controls">
                <button class="drag-handle" title="Drag to reorder" aria-label="Drag to reorder">⠿</button>
                <span class="order-badge">#${i+1}</span>
                <button class="cover-btn${isCover ? ' is-cover' : ''}" data-idx="${i}">
                  ${isCover ? '★ Cover' : '☆ Cover'}
                </button>
                <span class="photo-filename">${escHtml(photo.filename)}</span>
              </div>
              <div class="photo-img-wrapper">
                <img src="${imgSrc}" alt="${escHtml(photo.caption || photo.filename)}"
                     loading="lazy" onerror="this.parentElement.innerHTML='<div class=\\'img-placeholder\\'>Image not found</div>'" />
              </div>
              <input
                class="caption-input"
                type="text"
                data-idx="${i}"
                value="${escHtml(photo.caption)}"
                placeholder="One-line caption…"
                maxlength="200"
              />
            </div>
          </div>
        `;
      }

      function refreshCoverButtons() {
        document.querySelectorAll('.cover-btn').forEach(btn => {
          const idx = parseInt(btn.dataset.idx);
          const isCover = state.photos[idx]?.isCover;
          btn.className = `cover-btn${isCover ? ' is-cover' : ''}`;
          btn.textContent = isCover ? '★ Cover' : '☆ Cover';
        });
      }

      // ─── Drag reorder ──────────────────────────────────────────────────────
      function setupDragReorder() {
        const list = document.getElementById('photo-list');
        if (!list) return;
        let dragSrc = null;

        list.querySelectorAll('.photo-entry').forEach(entry => {
          entry.addEventListener('dragstart', e => {
            dragSrc = entry;
            entry.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', entry.dataset.idx);
          });
          entry.addEventListener('dragend', () => {
            entry.classList.remove('dragging');
            list.querySelectorAll('.photo-entry').forEach(e => e.classList.remove('drag-over'));
          });
          entry.addEventListener('dragover', e => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            list.querySelectorAll('.photo-entry').forEach(e => e.classList.remove('drag-over'));
            if (entry !== dragSrc) entry.classList.add('drag-over');
          });
          entry.addEventListener('drop', e => {
            e.preventDefault();
            if (!dragSrc || dragSrc === entry) return;
            const fromIdx = parseInt(dragSrc.dataset.idx);
            const toIdx = parseInt(entry.dataset.idx);
            const moved = state.photos.splice(fromIdx, 1)[0];
            state.photos.splice(toIdx, 0, moved);
            markDirty();
            renderStudio();
          });
        });
      }

      // ─── Save / autosave ───────────────────────────────────────────────────
      function markDirty() {
        isDirty = true;
        setSaveStatus('unsaved');
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(autoSave, 1500);
      }

      function setSaveStatus(s) {
        const el = document.getElementById('save-status');
        if (!el) return;
        el.className = `save-status ${s}`;
        el.textContent = s === 'saved' ? 'Saved' : s === 'unsaved' ? '● Unsaved' : 'Saving…';
      }

      async function autoSave() {
        if (!state || !isDirty) return;
        setSaveStatus('saving');
        try {
          await apiPost(`/sidecar/${state.slug}`, state);
          isDirty = false;
          setSaveStatus('saved');
        } catch (e) {
          setSaveStatus('unsaved');
          console.error('Save failed:', e);
        }
      }

      // Save on window unload
      window.addEventListener('beforeunload', e => {
        if (isDirty) {
          autoSave();
          e.preventDefault();
          e.returnValue = '';
        }
      });

      // ─── Export ────────────────────────────────────────────────────────────
      async function handleExport() {
        if (!state) return;
        // Save first
        await autoSave();
        try {
          const r = await fetch('/api/studio/export', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: state.slug }),
          });
          const data = await r.json();
          if (data.ok) {
            alert(`Exported to ${data.path}`);
          } else {
            alert(`Export failed: ${data.error}`);
          }
        } catch (e) {
          // Fallback: instruct user to run CLI
          alert(`Save complete. Run:\n  node scripts/export-mdx.mjs ${state.slug}`);
        }
      }

      // ─── Helpers ───────────────────────────────────────────────────────────
      function countWords(s) {
        return s.trim() ? s.trim().split(/\s+/).length : 0;
      }

      function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // ─── Boot ──────────────────────────────────────────────────────────────
      loadProjects();
    </script>
  </body>
</html>
