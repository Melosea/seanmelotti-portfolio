---
// Caption Studio — dev only. Injected by astro.config.mjs only when command === 'dev'.
// This file is NOT in src/pages/ and is never emitted in production builds.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Caption Studio</title>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        /* Studio chrome — dark */
        --bg: #0a0b0d;
        --surface: #141518;
        --surface2: #1e2024;
        --border: #2a2c32;
        --text: #e8eaed;
        --muted: #7c838e;
        --accent: #2f56d9;
        --accent-soft: #1a2d6e;
        --green: #0f6344;
        --green-soft: #e8f5ef;
        --warn: #7a4705;
        --warn-soft: #fdf3e4;
        --red-soft: #3d1a1a;
        --red: #f87171;
        --sans: "Inter Variable","Inter",system-ui,sans-serif;
        --mono: "JetBrains Mono Variable","JetBrains Mono",monospace;
        --header-h: 3rem;
        --sidebar-w: 220px;

        /* Page-preview tokens — mirrors published site */
        --page-bg: #ffffff;
        --page-text: #33373e;
        --page-muted: #7c838e;
        --page-line: #e8eaed;
        --page-caption-color: #5c626c;
        --page-caption-size: 0.875rem;       /* 14px = text-sm */
        --page-caption-lh: 1.4286;
        --page-col-max: 720px;               /* narrow content column — scannable preview */
        --page-seq-gap: 3.5rem;              /* vertical gap between steps */
        --page-caption-measure: 34rem;       /* max-width of caption text */
        --page-img-radius: 0.5rem;           /* radius-md from real page */
        --page-img-ratio: 3 / 2;             /* default landscape ratio */
      }

      html, body { height: 100%; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 14px; }

      /* ── Chrome layout ──────────────────────────────────────────────────── */
      .studio-layout {
        display: grid;
        grid-template-rows: var(--header-h) 1fr;
        grid-template-columns: var(--sidebar-w) 1fr;
        height: 100vh;
      }

      .studio-header {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1rem;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
      }

      .studio-header h1 {
        font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--muted); flex-shrink: 0;
      }

      .header-sep { width: 1px; height: 16px; background: var(--border); flex-shrink: 0; }

      .header-actions { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }

      .studio-sidebar {
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .studio-sidebar-header {
        padding: 0.75rem 1rem 0.625rem;
        border-bottom: 1px solid var(--border);
        font-size: 10px;
        font-family: var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .project-list { flex: 1; overflow-y: auto; padding: 0.375rem; }

      /* Group divider inside the list — Projects vs Skills. Quieter than the
         sidebar header above it so the hierarchy reads correctly. */
      .project-group-header {
        padding: 0.5rem 0.75rem 0.25rem;
        font-size: 9px; font-family: var(--mono);
        text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--muted); opacity: 0.8;
      }
      .project-group + .project-group .project-group-header { margin-top: 0.5rem; }

      .project-btn {
        display: block; width: 100%; text-align: left;
        padding: 0.5rem 0.75rem; border-radius: 5px;
        border: 1px solid transparent; background: transparent;
        color: var(--text); cursor: pointer; font-size: 12px;
        font-family: var(--sans); transition: background 0.15s; margin-bottom: 0;
      }
      .project-btn:hover { background: var(--surface2); }
      .project-btn.active { background: var(--accent-soft); border-color: var(--accent); color: #c7d3fa; }
      .project-btn .count { float: right; font-family: var(--mono); font-size: 10px; color: var(--muted); }
      /* Photos in the folder that the canvas has not imported yet. Dimmer than
         the canvas count so the two are never mistaken for each other. */
      .project-btn .count-disk { float: right; font-family: var(--mono); font-size: 10px; color: var(--accent); opacity: 0.75; margin-left: 4px; }

      .project-row { display: flex; align-items: center; gap: 0.25rem; margin-bottom: 2px; }
      .project-row .project-btn { flex: 1; min-width: 0; }

      .project-status {
        flex-shrink: 0; height: 22px; padding: 0 4px;
        font-size: 9px; font-family: var(--mono); letter-spacing: 0.04em;
        border-radius: 3px; border: 1px solid var(--border); background: var(--surface2);
        color: var(--muted); cursor: pointer; appearance: none; -webkit-appearance: none;
      }
      .project-status:focus { outline: none; border-color: var(--accent); }
      .project-status.status-completed { border-color: #1f5c30; color: #4ade80; background: #0d2a1d; }

      /* At-a-glance publish state, leftmost in the row so the whole list reads
         as one scannable strip. Deliberately the same glyphs and colours as the
         editor's .draft-toggle — the badge and the toggle must never need to be
         reconciled by eye. Display-only: the toggle stays the single write path. */
      .project-draft {
        flex-shrink: 0; width: 13px; text-align: center;
        font-size: 10px; line-height: 1; font-family: var(--mono);
        cursor: help; user-select: none;
      }
      .project-draft.is-live { color: #4ade80; }
      /* NOT var(--warn) — that token (#7a4705) is the dark-on-light value the
         toggle pairs with --warn-soft. On the dark sidebar it is near-invisible.
         This is its on-dark counterpart, the same way the toggle uses #4ade80
         on dark rather than the dark --green token. */
      .project-draft.is-draft { color: #fbbf24; }

      .sidebar-footer {
        padding: 0.375rem; border-top: 1px solid var(--border); flex-shrink: 0;
      }
      /* ── New-entry dialog ───────────────────────────────────────────────── */
      .modal-backdrop {
        position: fixed; inset: 0; z-index: 100;
        background: rgba(0,0,0,0.6);
        display: flex; align-items: center; justify-content: center;
      }
      .modal-backdrop[hidden] { display: none; }
      .modal {
        width: 340px; background: var(--surface);
        border: 1px solid var(--border); border-radius: 8px;
        padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;
      }
      .modal-title { font-size: 13px; font-weight: 600; }
      .modal-label {
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.3rem;
      }
      .modal-input {
        width: 100%; height: 28px; padding: 0 0.5rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 4px; color: var(--text);
        font-size: 12px; font-family: var(--sans);
      }
      .modal-input:focus { outline: none; border-color: var(--accent); }
      .segmented { display: flex; gap: 0; }
      .segmented button {
        flex: 1; height: 28px; font-size: 11px; font-family: var(--sans);
        background: var(--surface2); border: 1px solid var(--border);
        color: var(--muted); cursor: pointer; transition: all 0.15s;
      }
      .segmented button:first-child { border-radius: 4px 0 0 4px; }
      .segmented button:last-child { border-radius: 0 4px 4px 0; border-left: none; }
      .segmented button:hover { color: var(--text); }
      .segmented button[aria-pressed="true"] {
        background: var(--accent-soft); border-color: var(--accent); color: #c7d3fa;
      }
      .modal-hint { font-size: 10px; color: var(--muted); line-height: 1.4; }
      .modal-error { font-size: 11px; color: var(--red); }
      .modal-actions { display: flex; justify-content: flex-end; gap: 0.375rem; }

      /* ── Main scrollable area ───────────────────────────────────────────── */
      .studio-main { overflow-y: auto; display: flex; flex-direction: column; background: #111214; }

      /* ── Toolbar (sticky) ───────────────────────────────────────────────── */
      .toolbar {
        display: flex; align-items: center; gap: 0.625rem;
        padding: 0.5rem 1rem;
        background: var(--surface); border-bottom: 1px solid var(--border);
        flex-shrink: 0; flex-wrap: wrap; position: sticky; top: 0; z-index: 20;
      }

      .toolbar-group { display: flex; align-items: center; gap: 0.375rem; }
      .toolbar-sep { width: 1px; height: 16px; background: var(--border); }

      /* ── Shared button style (studio chrome) ────────────────────────────── */
      .btn {
        display: inline-flex; align-items: center; gap: 0.3rem;
        height: 26px; padding: 0 0.625rem; border-radius: 4px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--text); font-size: 11px; font-family: var(--sans);
        font-weight: 500; cursor: pointer; white-space: nowrap;
        transition: background 0.15s, border-color 0.15s;
      }
      .btn:hover { background: #2a2d34; border-color: #444; }
      .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      .btn-primary:hover { background: #2545b4; border-color: #2545b4; }

      .save-status {
        font-size: 10px; font-family: var(--mono); padding: 2px 7px;
        border-radius: 3px; white-space: nowrap;
      }
      .save-status.saved { background: #0d2a1d; color: #4ade80; }
      .save-status.unsaved { background: var(--warn-soft); color: var(--warn); }
      .save-status.saving { background: #1e2a3a; color: #60a5fa; }
      /* Sticky on purpose: a failed write must stay on screen until one succeeds. */
      .save-status.error { background: var(--red-soft); color: var(--red); cursor: help; }

      /* Live/Draft toggle — publish gate. Draft entries keep their sidecar and
         MDX on disk but are filtered out of every page query, so an entry can be
         worked on for weeks without ever appearing on the site. */
      .draft-toggle { font-weight: 600; letter-spacing: 0.01em; min-width: 92px; }
      .draft-toggle.is-live { background: #0d2a1d; color: #4ade80; border-color: #1c5137; }
      .draft-toggle.is-live:hover { background: #124430; }
      .draft-toggle.is-draft { background: var(--warn-soft); color: var(--warn); border-color: #5c4410; }
      .draft-toggle.is-draft:hover { background: #4a3a10; }

      .seq-counter {
        font-size: 10px; font-family: var(--mono); padding: 2px 7px;
        border-radius: 3px; background: var(--surface2); color: var(--muted);
        white-space: nowrap;
      }
      .seq-counter.on-target { color: #4ade80; }

      .missing-alt-badge {
        font-size: 10px; font-family: var(--mono); padding: 2px 7px;
        border-radius: 3px; background: var(--red-soft); color: var(--red);
        white-space: nowrap; display: none;
      }
      .missing-alt-badge.visible { display: inline-block; }

      /* ── Page preview wrapper ───────────────────────────────────────────── */
      .page-preview {
        flex: 1;
        padding: 2.5rem 1.5rem 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* Narrow content column — mirrors published site */
      .page-col {
        width: 100%;
        max-width: var(--page-col-max);
        display: flex;
        flex-direction: column;
      }

      /* ── Project header fields (inside preview) ──────────────────────────── */
      .page-header-area {
        background: var(--page-bg);
        border: 1px solid var(--page-line);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
      }

      .field-row { margin-bottom: 1rem; }
      .field-row:last-child { margin-bottom: 0; }

      .field-label {
        font-size: 9px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.25rem;
        display: flex; align-items: center; gap: 0.375rem;
      }

      .word-count, .char-count {
        font-size: 9px; font-family: var(--mono); padding: 1px 5px; border-radius: 3px;
        background: var(--surface2); color: var(--muted);
      }
      .word-count.warn, .char-count.warn { background: var(--warn-soft); color: var(--warn); }

      .header-input {
        width: 100%; padding: 0.5rem 0.625rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 5px; color: var(--text); font-size: 14px;
        font-family: var(--sans); font-weight: 540; line-height: 1.5;
        resize: none; min-height: 2.75rem; transition: border-color 0.15s;
      }
      .header-input:focus { outline: none; border-color: var(--accent); }

      /* ── Section headings in page preview ───────────────────────────────── */
      .preview-section-label {
        display: flex; align-items: center; gap: 0.625rem;
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted);
        margin-bottom: 1.5rem;
      }
      .preview-section-label::after {
        content: ''; flex: 1; height: 1px; background: var(--border);
      }

      /* ── Chapter divider (mirrors real seq-chapter) ──────────────────────── */
      .preview-chapter {
        display: flex; align-items: center; gap: 0.625rem;
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--page-muted);
        margin-bottom: 1.5rem; margin-top: 3rem;
        background: var(--page-bg);
        padding: 0.75rem 1rem;
        border-radius: 4px;
        border-left: 2px solid var(--page-line);
      }

      /* ── Photo step (page-preview style) ────────────────────────────────── */
      .step-block {
        position: relative;
        background: var(--page-bg);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: var(--page-seq-gap);
        /* Subtle shadow to indicate it's a page element */
        box-shadow: 0 1px 4px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.04);
      }

      /* Top control strip — dark chrome overlaid on the preview card */
      .step-controls {
        display: flex; align-items: center; gap: 0.375rem; flex-wrap: wrap;
        padding: 0.5rem 0.75rem;
        background: var(--surface); border-bottom: 1px solid var(--border);
        border-radius: 8px 8px 0 0;
      }

      .master-idx {
        font-family: var(--mono); font-size: 10px; color: var(--muted);
        min-width: 24px; text-align: center; flex-shrink: 0;
      }

      /* Destination selector */
      .dest-select {
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.05em; padding: 2px 5px; border-radius: 3px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--muted); cursor: pointer; appearance: none;
        -webkit-appearance: none;
      }
      .dest-select:focus { outline: none; border-color: var(--accent); }
      .dest-select.dest-main { border-color: var(--accent); color: #c7d3fa; background: var(--accent-soft); }
      .dest-select.dest-gallery { border-color: #2d6b4a; color: #4ade80; background: #0d2a1d; }
      .dest-select.dest-cut { border-color: #555; color: #555; }

      /* Seq position + up/down */
      .seq-controls { display: none; align-items: center; gap: 0.2rem; }
      .seq-controls.visible { display: flex; }
      .seq-pos-badge {
        font-family: var(--mono); font-size: 10px; color: #c7d3fa;
        background: var(--accent-soft); border: 1px solid var(--accent);
        padding: 1px 5px; border-radius: 3px; min-width: 28px; text-align: center;
      }
      .seq-btn {
        width: 20px; height: 20px; border-radius: 3px;
        border: 1px solid var(--border); background: var(--surface2);
        color: var(--muted); cursor: pointer; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.1s;
      }
      .seq-btn:hover { background: #2a2d34; color: var(--text); }
      .seq-btn:disabled { opacity: 0.3; cursor: not-allowed; }

      /* Hero radio */
      .hero-label {
        display: flex; align-items: center; gap: 0.2rem;
        font-size: 10px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; padding: 2px 6px; border-radius: 3px;
        border: 1px solid var(--border); background: transparent;
        color: var(--muted); cursor: pointer; transition: all 0.15s;
        white-space: nowrap;
      }
      .hero-label input { display: none; }
      .hero-label:has(input:checked) {
        background: #1a3a1a; border-color: #1f5c30; color: #4ade80;
      }

      .photo-filename { font-family: var(--mono); font-size: 10px; color: var(--muted); margin-left: auto; }

      /* Per-photo save indicator */
      .photo-save-indicator {
        font-size: 10px; font-family: var(--mono); padding: 1px 5px;
        border-radius: 3px; white-space: nowrap; flex-shrink: 0;
        opacity: 0; transition: opacity 0.3s;
      }
      .photo-save-indicator.dirty { background: var(--warn-soft); color: var(--warn); opacity: 1; }
      .photo-save-indicator.saved { background: #0d2a1d; color: #4ade80; opacity: 1; }

      /* ── Image area (page-preview style) ────────────────────────────────── */
      .step-image-area {
        background: #f5f6f7; /* matches --color-surface-sunken from real page */
        overflow: hidden;
      }

      .step-image-area img {
        width: 100%;
        aspect-ratio: var(--page-img-ratio);
        object-fit: cover;
        display: block;
      }

      /* Portrait orientation */
      .step-block.portrait .step-image-area img {
        aspect-ratio: 2 / 3;
        max-width: 60%;
        margin-inline: auto;
      }

      /* Placeholder when image doesn't load */
      .img-placeholder {
        aspect-ratio: var(--page-img-ratio);
        display: flex; align-items: center; justify-content: center;
        color: var(--muted); font-size: 12px; font-family: var(--mono);
        background: var(--surface2);
      }

      /* ── Caption area (page-preview style) ──────────────────────────────── */
      .step-caption-area {
        padding: 0.75rem 1rem 1rem;
        background: var(--page-bg);
      }

      /* Caption textarea styled to match published figcaption */
      .caption-input {
        width: 100%;
        max-width: var(--page-caption-measure);
        font-size: var(--page-caption-size);
        line-height: var(--page-caption-lh);
        color: var(--page-text);
        font-family: var(--sans);
        background: transparent;
        border: none;
        border-bottom: 1px dashed #d0d3d8;
        border-radius: 0;
        padding: 0.125rem 0;
        resize: none;
        overflow: hidden;
        min-height: 1.5rem;
        display: block;
        transition: border-color 0.15s;
        outline: none;
      }
      .caption-input:focus { border-bottom-color: var(--accent); }
      .caption-input::placeholder { color: #c0c3c9; font-style: italic; }

      /* Caption meta row */
      .caption-meta {
        display: flex; align-items: center; gap: 0.375rem; margin-top: 0.375rem;
      }
      .caption-field-label {
        font-size: 9px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; color: #b0b5be;
        display: flex; align-items: center; gap: 0.25rem;
      }

      /* ── Alt text row (de-emphasized below caption) ──────────────────────── */
      .alt-row {
        padding: 0.5rem 1rem 0.75rem;
        background: #f9fafb;
        border-top: 1px solid #f0f1f3;
      }
      .alt-input {
        width: 100%;
        padding: 0.3rem 0.5rem;
        background: #fff; border: 1px solid #e0e2e6;
        border-radius: 4px; color: #5c626c; font-size: 12px;
        font-family: var(--sans); line-height: 1.45;
        transition: border-color 0.15s;
        resize: none; overflow: hidden; min-height: 2rem;
        display: block;
      }
      .alt-input:focus { outline: none; border-color: var(--accent); }
      .alt-input::placeholder { color: #b0b5be; }

      .alt-field-label {
        font-size: 9px; font-family: var(--mono); text-transform: uppercase;
        letter-spacing: 0.06em; color: #b0b5be;
        display: flex; align-items: center; gap: 0.25rem;
        margin-bottom: 0.25rem;
      }
      .alt-missing-warn {
        display: none; font-size: 10px; font-family: var(--mono);
        color: var(--red); margin-top: 0.2rem;
      }
      .alt-missing-warn.visible { display: block; }

      /* ── Greyed out / cut state ──────────────────────────────────────────── */
      .step-block.dest-cut .step-image-area { opacity: 0.3; }
      .step-block.dest-cut .step-caption-area,
      .step-block.dest-cut .alt-row { opacity: 0.35; pointer-events: none; }

      /* ── Drag-and-drop ───────────────────────────────────────────────────── */
      .step-block[draggable="true"] { cursor: grab; }
      .step-block[draggable="true"]:active { cursor: grabbing; }
      .step-block.drag-over { outline: 2px solid var(--accent); outline-offset: 2px; }

      /* ── Empty / loading states ──────────────────────────────────────────── */
      .empty-state {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 0.75rem; color: var(--muted); font-size: 13px;
        padding: 3rem; text-align: center;
      }
      .empty-state h2 { font-size: 18px; color: var(--text); font-weight: 500; }

      .loading { text-align: center; padding: 3rem; color: var(--muted); font-family: var(--mono); font-size: 12px; }

      /* ── Cut section (collapsed at bottom) ───────────────────────────────── */
      .cut-section-toggle {
        display: flex; align-items: center; gap: 0.5rem;
        cursor: pointer; font-size: 10px; font-family: var(--mono);
        text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted);
        padding: 0.5rem 0; border: none; background: none; width: 100%;
        margin-top: 2rem;
      }
      .cut-section-toggle:hover { color: var(--text); }
      .cut-list { display: none; }
      .cut-list.open { display: flex; flex-direction: column; }

      /* ── Add-project sidebar form ───────────────────────────────────────── */
      .sidebar-footer {
        padding: 0.5rem 0.375rem;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
      }

      .btn-add-project {
        display: flex; align-items: center; justify-content: center; gap: 0.3rem;
        width: 100%; height: 26px; border-radius: 4px;
        border: 1px dashed var(--border); background: transparent;
        color: var(--muted); font-size: 11px; font-family: var(--sans);
        cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .btn-add-project:hover { background: var(--surface2); color: var(--text); border-color: #444; }

      .add-project-actions { display: flex; gap: 0.25rem; }
      .add-project-actions .btn { flex: 1; justify-content: center; }

      /* ── Blank-canvas add flow ───────────────────────────────────────────── */
      .blank-canvas-cta {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; gap: 1rem; padding: 4rem 2rem;
        text-align: center; color: var(--muted);
        background: var(--page-bg); border-radius: 8px;
        border: 2px dashed var(--page-line); margin-bottom: 2rem;
      }
      .blank-canvas-cta h3 { font-size: 18px; font-weight: 500; color: var(--text); margin-bottom: 0.25rem; }
      .blank-canvas-cta p { font-size: 13px; }
      .btn-lg { height: 34px; padding: 0 1.25rem; font-size: 12px; }
      .add-source-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

      /* ── Delete-from-canvas button ───────────────────────────────────────── */
      .btn-delete {
        width: 22px; height: 22px; padding: 0; flex-shrink: 0; margin-left: auto;
        border: 1px solid #4d1a1a; background: var(--red-soft);
        color: var(--red); border-radius: 3px; font-size: 14px; line-height: 1;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: background 0.15s;
      }
      .btn-delete:hover { background: #5a1c1c; }

      /* ── Page editor ─────────────────────────────────────────────────────── */
      .page-array-item {
        margin-bottom: 0.875rem;
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: var(--surface);
      }
      .page-field-input {
        width: 100%; padding: 0.5rem 0.625rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 5px; color: var(--text); font-size: 14px;
        font-family: var(--sans); line-height: 1.5;
        resize: none; transition: border-color 0.15s;
      }
      .page-field-input:focus { outline: none; border-color: var(--accent); }
      .page-field-grid-2 { display: grid; grid-template-columns: 1fr 2fr; gap: 0.5rem; }
      .page-field-input[readonly] { opacity: 0.6; cursor: not-allowed; }
      /* ── Publish button & status ─────────────────────────────────────────── */
      .btn-publish {
        background: #0d2a1d; border-color: #1c5137; color: #4ade80; font-weight: 600;
      }
      .btn-publish:hover { background: #124430; border-color: #2a7a4f; }
      .btn-publish:disabled { opacity: 0.5; cursor: not-allowed; }

      .publish-count-badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 16px; height: 14px; padding: 0 3px; margin-left: 4px;
        background: #4ade80; color: #062414; border-radius: 6px;
        font-size: 9px; font-family: var(--mono); font-weight: 700; line-height: 1;
        vertical-align: middle;
      }

      .publish-inline-status {
        font-size: 10px; font-family: var(--mono); padding: 2px 7px;
        border-radius: 3px; white-space: nowrap;
      }
      .publish-inline-status.pushing { background: #1e2a3a; color: #60a5fa; }
      .publish-inline-status.success { background: #0d2a1d; color: #4ade80; }
      .publish-inline-status.error   { background: var(--red-soft); color: var(--red); }

      /* ── Publish confirm modal extras ───────────────────────────────────── */
      .publish-file-list {
        max-height: 180px; overflow-y: auto; list-style: none;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 4px; padding: 0.375rem 0.5rem; margin: 0;
      }
      .publish-file-list li {
        display: flex; gap: 0.375rem; align-items: baseline;
        padding: 2px 0; font-size: 11px; font-family: var(--mono); color: var(--text);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .publish-file-list .file-xy {
        flex-shrink: 0; width: 14px; text-align: center;
        font-size: 9px; color: var(--muted);
      }
      .publish-branch-line {
        font-family: var(--mono); font-size: 11px; color: #c7d3fa;
        background: var(--accent-soft); border: 1px solid var(--accent);
        border-radius: 3px; padding: 2px 6px; display: inline-block;
      }
      .publish-msg-input {
        width: 100%; height: 28px; padding: 0 0.5rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 4px; color: var(--text);
        font-size: 12px; font-family: var(--sans);
      }
      .publish-msg-input:focus { outline: none; border-color: var(--accent); }
      .publish-warn {
        font-size: 10px; font-family: var(--mono); padding: 4px 8px;
        background: #2a1f00; border: 1px solid #5c4410; border-radius: 3px;
        color: #fbbf24;
      }
      /* ── Photo editor modal ──────────────────────────────────────────────────── */
      .photo-editor-modal { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; }
      .photo-editor-modal[hidden] { display: none; }
      .photo-editor-inner { width: 92vw; max-width: 1140px; height: 90vh; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; display: flex; flex-direction: column; overflow: hidden; }
      .photo-editor-header { display: flex; align-items: center; gap: 0.625rem; padding: 0.5rem 1rem; background: var(--surface); border-bottom: 1px solid var(--border); flex-shrink: 0; }
      .photo-editor-title { font-size: 12px; font-weight: 600; color: var(--text); }
      .photo-editor-filename { font-family: var(--mono); font-size: 10px; color: var(--muted); }
      .pe-original-badge { font-size: 9px; font-family: var(--mono); padding: 1px 6px; border-radius: 3px; background: var(--accent-soft); color: #c7d3fa; }
      .photo-editor-body { flex: 1; display: flex; overflow: hidden; min-height: 0; }
      .photo-editor-canvas-area { flex: 1; display: flex; align-items: center; justify-content: center; background: #0d0e10; overflow: hidden; position: relative; }
      .photo-editor-canvas-wrap { position: relative; display: inline-block; line-height: 0; }
      #pe-canvas { display: block; max-width: calc(92vw - 240px); max-height: calc(90vh - 80px); width: auto; height: auto; }
      #pe-crop-canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: crosshair; }
      .photo-editor-controls { width: 220px; flex-shrink: 0; background: var(--surface2); border-left: 1px solid var(--border); display: flex; flex-direction: column; overflow-y: auto; }
      .pe-section { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--border); flex-shrink: 0; }
      .pe-section-label { font-size: 9px; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.5rem; }
      .pe-btn-row { display: flex; gap: 0.3rem; flex-wrap: wrap; }
      .pe-btn { height: 24px; padding: 0 0.5rem; border-radius: 4px; border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: 11px; font-family: var(--sans); cursor: pointer; transition: background 0.15s; white-space: nowrap; }
      .pe-btn:hover { background: #2a2d34; border-color: #444; }
      .pe-slider-row { margin-bottom: 0.5rem; }
      .pe-slider-row:last-child { margin-bottom: 0; }
      .pe-slider-label { display: flex; justify-content: space-between; align-items: center; font-size: 10px; font-family: var(--mono); color: var(--muted); margin-bottom: 0.2rem; }
      .pe-slider-val { color: var(--text); }
      .pe-slider { width: 100%; height: 4px; appearance: none; -webkit-appearance: none; background: var(--border); border-radius: 2px; cursor: pointer; outline: none; }
      .pe-slider::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); cursor: pointer; }
      .pe-slider::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); border: none; cursor: pointer; }
      .pe-footer { display: flex; gap: 0.375rem; padding: 0.625rem 0.75rem; border-top: 1px solid var(--border); flex-shrink: 0; margin-top: auto; }
      .pe-footer .btn { flex: 1; justify-content: center; font-size: 11px; }
      .btn-pe-revert { background: var(--red-soft); border-color: #4d1a1a; color: var(--red); }
      .btn-pe-revert:hover { background: #5a1c1c; }
      .btn-edit-photo { width: 22px; height: 22px; padding: 0; flex-shrink: 0; border: 1px solid var(--border); background: var(--surface2); color: var(--muted); border-radius: 3px; font-size: 11px; line-height: 1; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.15s; }
      .btn-edit-photo:hover { background: #2a2d34; color: var(--text); }
    </style>
  </head>
  <body>
    <div class="studio-layout">
      <header class="studio-header">
        <h1>Caption Studio</h1>
        <div id="toolbar-inline" style="display:none" class="toolbar-group">
          <span id="save-status-header" class="save-status saved">Saved</span>
        </div>
        <div class="header-actions">
          <span id="publish-inline-status" class="publish-inline-status" hidden></span>
          <button class="btn btn-publish" id="btn-publish" type="button"
            title="Publish staged content files to GitHub">
            ↑ Publish to GitHub<span class="publish-count-badge" id="publish-count-badge" hidden>0</span>
          </button>
        </div>
      </header>

      <aside class="studio-sidebar">
        <div class="studio-sidebar-header">Library</div>
        <div class="project-list" id="project-list">
          <div class="loading">Loading…</div>
        </div>
        <div class="sidebar-footer">
          <button class="btn-add-project" id="btn-add-project" type="button">+ New Entry</button>
        </div>
      </aside>

      <main class="studio-main" id="studio-main">
        <div class="empty-state" id="empty-state">
          <h2>Select a project</h2>
          <p>Choose a project from the sidebar to start editing.</p>
        </div>
      </main>
    </div>

    <!-- Hidden file picker — triggered by Add Photos buttons -->
    <input type="file" id="file-input" accept="image/*" multiple hidden />

    <!-- New-entry dialog. Replaces window.prompt so the collection can be chosen. -->
    <div class="modal-backdrop" id="new-entry-modal" hidden>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="new-entry-title">
        <div class="modal-title" id="new-entry-title">New entry</div>
        <div>
          <div class="modal-label">Name</div>
          <input class="modal-input" id="new-entry-name" placeholder="e.g. Metal Shaping" autocomplete="off" />
        </div>
        <div>
          <div class="modal-label">Collection</div>
          <div class="segmented" id="new-entry-type">
            <button type="button" data-type="project" aria-pressed="true">Project</button>
            <button type="button" data-type="skill" aria-pressed="false">Skill</button>
          </div>
          <p class="modal-hint" id="new-entry-hint">Exports to src/content/projects/ &rarr; /projects/&lt;slug&gt;</p>
        </div>
        <p class="modal-error" id="new-entry-error" hidden></p>
        <div class="modal-actions">
          <button class="btn" id="new-entry-cancel">Cancel</button>
          <button class="btn btn-primary" id="new-entry-create">Create</button>
        </div>
      </div>
    </div>

    <!-- Publish confirm modal -->
    <div class="modal-backdrop" id="publish-modal" hidden>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="publish-modal-title" style="width:420px">
        <div class="modal-title" id="publish-modal-title">↑ Publish to GitHub</div>
        <div>
          <div class="modal-label">Branch</div>
          <span class="publish-branch-line" id="publish-modal-branch">—</span>
        </div>
        <div>
          <div class="modal-label">Files to commit
            <span style="margin-left:4px;opacity:0.7" id="publish-modal-file-count">(0)</span>
          </div>
          <ul class="publish-file-list" id="publish-modal-file-list">
            <li style="color:var(--muted)">No changes in allowed paths.</li>
          </ul>
        </div>
        <div id="publish-behind-warn" class="publish-warn" hidden>
          ⚠ Remote has commits you don't have locally (behind). Push may be rejected — pull first.
        </div>
        <div>
          <div class="modal-label">Commit message (leave blank for timestamp)</div>
          <input class="publish-msg-input" id="publish-modal-msg"
            placeholder="Studio publish <ISO timestamp>" autocomplete="off" />
        </div>
        <p class="modal-error" id="publish-modal-error" hidden></p>
        <div class="modal-actions">
          <button class="btn" id="publish-modal-cancel">Cancel</button>
          <button class="btn btn-publish" id="publish-modal-confirm">↑ Push to GitHub</button>
        </div>
      </div>
    </div>


    <!-- Photo editor modal -->
    <div class="photo-editor-modal" id="photo-editor-modal" hidden>
      <div class="photo-editor-inner">
        <div class="photo-editor-header">
          <span class="photo-editor-title">Edit Photo</span>
          <span class="photo-editor-filename" id="pe-filename"></span>
          <span class="pe-original-badge" id="pe-original-badge" hidden>Original saved</span>
          <div style="margin-left:auto;display:flex;gap:0.375rem;align-items:center">
            <span id="pe-status" style="font-size:10px;font-family:var(--mono);color:var(--muted)"></span>
            <button class="btn" id="pe-cancel">Cancel</button>
          </div>
        </div>
        <div class="photo-editor-body">
          <div class="photo-editor-canvas-area">
            <div class="photo-editor-canvas-wrap" id="pe-canvas-wrap">
              <canvas id="pe-canvas"></canvas>
              <canvas id="pe-crop-canvas"></canvas>
            </div>
          </div>
          <div class="photo-editor-controls">
            <div class="pe-section">
              <div class="pe-section-label">Crop</div>
              <div class="pe-btn-row">
                <button class="pe-btn" id="pe-reset-crop">Reset crop</button>
              </div>
            </div>
            <div class="pe-section">
              <div class="pe-section-label">Rotate &amp; Flip</div>
              <div class="pe-btn-row">
                <button class="pe-btn" id="pe-rot-ccw" title="Rotate 90° counter-clockwise">↺ CCW</button>
                <button class="pe-btn" id="pe-rot-cw" title="Rotate 90° clockwise">↻ CW</button>
                <button class="pe-btn" id="pe-flip-h" title="Flip horizontal">⇔ H</button>
                <button class="pe-btn" id="pe-flip-v" title="Flip vertical">⇕ V</button>
              </div>
            </div>
            <div class="pe-section">
              <div class="pe-section-label">Adjustments</div>
              <div class="pe-slider-row">
                <div class="pe-slider-label">Brightness <span class="pe-slider-val" id="pe-bright-val">1.0</span></div>
                <input class="pe-slider" type="range" id="pe-bright" min="0.1" max="2.0" step="0.05" value="1.0" />
              </div>
              <div class="pe-slider-row">
                <div class="pe-slider-label">Contrast <span class="pe-slider-val" id="pe-contrast-val">1.0</span></div>
                <input class="pe-slider" type="range" id="pe-contrast" min="0.1" max="2.0" step="0.05" value="1.0" />
              </div>
              <div class="pe-slider-row">
                <div class="pe-slider-label">Saturation <span class="pe-slider-val" id="pe-sat-val">1.0</span></div>
                <input class="pe-slider" type="range" id="pe-sat" min="0.0" max="3.0" step="0.05" value="1.0" />
              </div>
            </div>
            <div class="pe-footer">
              <button class="btn btn-pe-revert" id="pe-revert" hidden title="Restore the saved original">↩ Revert</button>
              <button class="btn btn-primary" id="pe-save">Save</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script type="module">
      // ─── State ──────────────────────────────────────────────────────────────
      let currentSlug = null;
      let state = null;
      let currentPage = null;
      let pageState = null;
      let isDirty = false;
      /**
       * What the badge is allowed to say: 'saved' | 'unsaved' | 'saving' | 'error'.
       * Held here rather than read off the DOM so a re-render of the toolbar cannot
       * quietly resurrect a stale "Saved" after a write that actually failed.
       */
      let saveState = 'saved';
      let saveError = null;
      /** Debounce handle for the autosave that follows an edit. */
      let autoSaveTimer = null;
      let dirtyPhotos = new Set();
      let dragSrcFn = null;
      /**
       * What is in src/assets/photos/<slug>/ right now. Kept separate from
       * `state` on purpose: `state` is posted verbatim to the sidecar, and the
       * folder listing is not sidecar data — it is only the source of the
       * "import these" offer.
       */
      let diskPhotos = { files: [], manifest: null };

      const projectList = document.getElementById('project-list');
      const studioMain = document.getElementById('studio-main');
      const emptyState = document.getElementById('empty-state');
      const toolbarInline = document.getElementById('toolbar-inline');

      // ─── API ────────────────────────────────────────────────────────────────
      async function apiGet(path) {
        const r = await fetch(`/api/studio${path}`);
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      }
      async function apiPost(path, body) {
        const r = await fetch(`/api/studio${path}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!r.ok) throw new Error(await r.text());
        return r.json();
      }

      // ─── Page editor ─────────────────────────────────────────────────────────
      const PAGE_SCHEMAS = {
        home: [
          { key: 'positioning', label: 'Positioning line', hint: 'Main tagline shown above the hero heading' },
          { key: 'tagline', label: 'Hero tagline', hint: 'Sentence under the name in the hero section' },
          { key: 'ctaText', label: 'CTA button text', hint: 'Text in the call-to-action bubble' },
          { key: 'ctaSubtext', label: 'CTA sub-text', hint: 'Small line below the CTA bubble' },
        ],
        about: [
          { key: 'lede', label: 'Page lede', hint: 'Subtitle shown in the page header' },
          { key: 'intro', label: 'Intro paragraphs', type: 'paragraphs', hint: 'Separate paragraphs with a blank line' },
          { key: 'disciplines', label: 'Disciplines', type: 'object-array', fields: ['name', 'description'] },
          { key: 'facts', label: 'Facts', type: 'nullable-array', fields: ['label', 'value'], hint: 'Leave value blank to hide that fact' },
          { key: 'closingHeading', label: 'Closing section heading' },
        ],
        contact: [
          { key: 'heading', label: 'Page heading' },
          { key: 'lede', label: 'Page lede' },
          { key: 'contactMethods', label: 'Contact methods', type: 'object-array', fields: ['label', 'href', 'value'] },
          { key: 'footerNote', label: 'Footer note' },
        ],
        '404': [
          { key: 'eyebrow', label: 'Error eyebrow', hint: 'Small text above the heading' },
          { key: 'heading', label: 'Page heading' },
          { key: 'body', label: 'Body text' },
        ],
      };

      const PAGE_LABELS = { home: 'Home /', about: 'About', contact: 'Contact', '404': '404' };

      async function loadPage(pageId) {
        // Flush pending changes before switching
        if (isDirty) {
          if (autoSaveTimer) { clearTimeout(autoSaveTimer); autoSaveTimer = null; }
          await autoSave();
        } else if (autoSaveTimer) {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = null;
        }
        currentSlug = null;
        currentPage = pageId;
        // Update URL
        history.replaceState({}, '', `?page=${encodeURIComponent(pageId)}`);
        // Highlight active sidebar button
        document.querySelectorAll('.project-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.page-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.page === pageId);
        });
        studioMain.innerHTML = '<div class="loading">Loading\u2026</div>';
        toolbarInline.style.display = '';
        try {
          const r = await fetch(`/api/studio/page-content/${pageId}`);
          if (!r.ok) throw new Error(await r.text());
          pageState = await r.json();
        } catch (e) {
          studioMain.innerHTML = `<div class="empty-state"><h2>Load failed</h2><p>${escHtml(e.message)}</p></div>`;
          return;
        }
        isDirty = false;
        renderPageEditor();
        setSaveStatus('saved');
      }

      function renderPageField(field, value) {
        const { key, label, type, hint, fields } = field;
        const hintHtml = hint ? `<span style="font-size:9px;color:var(--muted);font-weight:400;margin-left:0.375rem">${escHtml(hint)}</span>` : '';
        if (type === 'paragraphs') {
          const text = Array.isArray(value) ? value.join('\n\n') : (value ?? '');
          return `<div class="field-row">
            <div class="field-label">${escHtml(label)}${hintHtml}</div>
            <textarea class="header-input page-field-input" data-page-key="${escHtml(key)}" data-page-type="paragraphs" rows="5">${escHtml(text)}</textarea>
          </div>`;
        }
        if (type === 'object-array') {
          const items = Array.isArray(value) ? value : [];
          const itemsHtml = items.map((item, i) => {
            const flds = fields.map(f => `<div class="field-row" style="margin-bottom:0.5rem">
              <div class="field-label">${escHtml(f)}</div>
              <textarea class="header-input page-field-input" data-page-key="${escHtml(key)}" data-page-idx="${i}" data-page-field="${escHtml(f)}" rows="1">${escHtml(item[f] ?? '')}</textarea>
            </div>`).join('');
            return `<div class="page-array-item">${flds}</div>`;
          }).join('');
          return `<div class="field-row">
            <div class="field-label">${escHtml(label)}</div>
            <div>${itemsHtml}</div>
          </div>`;
        }
        if (type === 'nullable-array') {
          const items = Array.isArray(value) ? value : [];
          const itemsHtml = items.map((item, i) => {
            return `<div class="page-field-grid-2" style="margin-bottom:0.5rem">
              <div>
                <div class="field-label">${escHtml(fields[0])}</div>
                <input class="page-field-input" type="text" style="height:2.25rem;display:block" readonly
                  data-page-key="${escHtml(key)}" data-page-idx="${i}" data-page-field="${escHtml(fields[0])}"
                  value="${escHtml(item[fields[0]] ?? '')}" />
              </div>
              <div>
                <div class="field-label">${escHtml(fields[1])}</div>
                <input class="page-field-input" type="text" style="height:2.25rem;display:block"
                  data-page-key="${escHtml(key)}" data-page-idx="${i}" data-page-field="${escHtml(fields[1])}"
                  value="${escHtml(item[fields[1]] ?? '')}"
                  placeholder="(leave blank to hide)" />
              </div>
            </div>`;
          }).join('');
          return `<div class="field-row">
            <div class="field-label">${escHtml(label)}${hintHtml}</div>
            <div>${itemsHtml}</div>
          </div>`;
        }
        // Default: simple textarea
        return `<div class="field-row">
          <div class="field-label">${escHtml(label)}${hintHtml}</div>
          <textarea class="header-input page-field-input" data-page-key="${escHtml(key)}" rows="1">${escHtml(String(value ?? ''))}</textarea>
        </div>`;
      }

      function renderPageEditor() {
        if (!currentPage || !pageState) return;
        emptyState.style.display = 'none';
        const schema = PAGE_SCHEMAS[currentPage] ?? [];
        const pageLabel = PAGE_LABELS[currentPage] ?? currentPage;
        const fieldsHtml = schema.map(field => renderPageField(field, pageState[field.key])).join('');
        studioMain.innerHTML = `
          <div class="toolbar">
            <div class="toolbar-group">
              <span style="font-size:10px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:0.06em">
                Page: ${escHtml(pageLabel)}
              </span>
            </div>
            <div class="toolbar-sep"></div>
            <button class="btn btn-primary" id="page-save-btn">Save</button>
            <span id="save-status" class="save-status ${saveState}">${SAVE_LABEL[saveState] ?? saveState}</span>
          </div>
          <div class="page-preview">
            <div class="page-col" id="page-field-list">
              <div class="preview-section-label">${escHtml(pageLabel)} page</div>
              <div class="page-header-area">
                ${fieldsHtml}
              </div>
            </div>
          </div>
        `;
        bindPageEvents();
      }

      function bindPageEvents() {
        document.getElementById('page-save-btn')?.addEventListener('click', () => autoSave());
        const list = document.getElementById('page-field-list');
        if (!list) return;
        list.addEventListener('input', e => {
          const input = e.target;
          if (!input.dataset.pageKey) return;
          const key = input.dataset.pageKey;
          const type = input.dataset.pageType;
          const idxStr = input.dataset.pageIdx;
          const field = input.dataset.pageField;
          if (type === 'paragraphs') {
            pageState[key] = input.value.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
          } else if (idxStr !== undefined && field) {
            const idx = parseInt(idxStr, 10);
            if (!Array.isArray(pageState[key])) pageState[key] = [];
            if (!pageState[key][idx]) pageState[key][idx] = {};
            const v = input.value.trim();
            pageState[key][idx][field] = v === '' && input.placeholder ? null : input.value;
          } else {
            pageState[key] = input.value;
          }
          markDirty();
        });
        list.querySelectorAll('.page-field-input').forEach(ta => {
          if (ta.tagName !== 'TEXTAREA') return;
          const grow = () => { ta.style.height = ''; ta.style.height = ta.scrollHeight + 'px'; };
          ta.addEventListener('input', grow);
          grow();
        });
      }

      async function savePageContent() {
        if (!currentPage || !pageState) return false;
        if (!isDirty) return saveState !== 'error';
        if (autoSaveTimer) { clearTimeout(autoSaveTimer); autoSaveTimer = null; }
        setSaveStatus('saving');
        try {
          const r = await fetch(`/api/studio/page-content/${currentPage}`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(pageState, null, 2),
          });
          if (!r.ok) throw new Error(await r.text());
          const result = await r.json();
          if (!result?.ok) throw new Error(`Unexpected response: ${JSON.stringify(result)}`);
          isDirty = false;
          setSaveStatus('saved');
          return true;
        } catch (e) {
          setSaveStatus('error', e?.message ?? String(e));
          console.error('Page save failed:', e);
          return false;
        }
      }
      // ─── Load projects list ─────────────────────────────────────────────────
      async function loadProjects() {
        const { projects } = await apiGet('/projects');
        projectList.innerHTML = '';
        if (!projects.length) {
          projectList.innerHTML = '<div class="loading">Nothing here yet.</div>';
          return;
        }

        // Projects and skills are two collections on disk, so the sidebar shows
        // them as two groups. An entry with no `type` is a project — the same
        // default the exporter uses.
        const groups = [
          { label: 'Projects', entries: projects.filter(p => (p.type ?? 'project') !== 'skill') },
          { label: 'Skills', entries: projects.filter(p => p.type === 'skill') },
        ].filter(g => g.entries.length > 0);

        for (const group of groups) {
          const section = document.createElement('div');
          section.className = 'project-group';
          const heading = document.createElement('div');
          heading.className = 'project-group-header';
          heading.textContent = `${group.label} (${group.entries.length})`;
          section.appendChild(heading);
          for (const p of group.entries) renderProjectRow(p, section);
          projectList.appendChild(section);
        }

        // Pages group — static site pages whose text content is editable from Studio
        {
          const pagesSection = document.createElement('div');
          pagesSection.className = 'project-group';
          const pagesHeading = document.createElement('div');
          pagesHeading.className = 'project-group-header';
          pagesHeading.textContent = 'Pages (4)';
          pagesSection.appendChild(pagesHeading);
          const PAGES = [
            { id: 'home', label: 'Home /' },
            { id: 'about', label: 'About' },
            { id: 'contact', label: 'Contact' },
            { id: '404', label: '404' },
          ];
          for (const p of PAGES) {
            const row = document.createElement('div');
            row.className = 'project-row';
            const btn = document.createElement('button');
            btn.className = 'project-btn page-btn';
            btn.dataset.page = p.id;
            btn.textContent = p.label;
            btn.addEventListener('click', () => loadPage(p.id));
            row.appendChild(btn);
            pagesSection.appendChild(row);
          }
          projectList.appendChild(pagesSection);
        }
        // Auto-restore last-selected entry from URL param (survives Vite HMR reloads)
        const urlSlug = new URLSearchParams(location.search).get('project');
        const urlPage = new URLSearchParams(location.search).get('page');
        if (urlSlug && projects.some(p => p.slug === urlSlug)) {
          loadProject(urlSlug);
        } else if (urlPage && ['home','about','contact','404'].includes(urlPage)) {
          loadPage(urlPage);
        }
      }

      /** One sidebar row: select button + status dropdown. */
      function renderProjectRow(p, container) {
        {
          const row = document.createElement('div');
          row.className = 'project-row';

          // Publish state first, so scanning the column answers "what's live?"
          // without opening anything. `draft` comes from the sidecar via the
          // list endpoint; a sidecar with no draft key is Live (exporter default).
          const dot = document.createElement('span');
          dot.className = `project-draft ${p.draft ? 'is-draft' : 'is-live'}`;
          dot.dataset.slug = p.slug;
          dot.textContent = p.draft ? '◌' : '●';
          dot.title = p.draft
            ? `${p.slug} — Draft, hidden from the site`
            : `${p.slug} — Live on the site`;
          row.appendChild(dot);

          const btn = document.createElement('button');
          btn.className = 'project-btn';
          btn.dataset.slug = p.slug;
          // The canvas count is the editable truth; the folder count only matters
          // as "there are N more you have not pulled in yet".
          const canvasCount = p.canvasCount ?? 0;
          const pending = Math.max(0, (p.diskCount ?? 0) - canvasCount);
          btn.innerHTML = `${p.slug}`
            + (pending > 0 ? `<span class="count-disk" title="${pending} photo(s) in the folder not yet on the canvas">+${pending}</span>` : '')
            + `<span class="count" title="${canvasCount} photo(s) on the canvas">${canvasCount}</span>`;
          btn.addEventListener('click', () => loadProject(p.slug));

          row.appendChild(btn);

          // Skills are a display of a skillset, not a dated build: WIP/Done is
          // meaningless there, so the status control is projects-only.
          if (p.type !== 'skill') {
            const sel = document.createElement('select');
            const normalStatus = p.status === 'complete' ? 'completed' : (p.status ?? 'in-progress');
            sel.className = `project-status${normalStatus === 'completed' ? ' status-completed' : ''}`;
            sel.dataset.slug = p.slug;
            sel.title = 'Project status';
            sel.innerHTML = `
              <option value="in-progress"${normalStatus === 'in-progress' ? ' selected' : ''}>WIP</option>
              <option value="completed"${normalStatus === 'completed' ? ' selected' : ''}>Done</option>
            `;
            sel.addEventListener('change', () => handleStatusChange(p.slug, sel.value, sel));
            row.appendChild(sel);
          }
          container.appendChild(row);
        }
      }

      // ─── Status change ──────────────────────────────────────────────────────
      async function handleStatusChange(slug, status, selectEl) {
        try {
          const r = await fetch('/api/studio/set-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, status }),
          });
          if (!r.ok) throw new Error((await r.json()).error ?? await r.text());
          selectEl.className = `project-status${status === 'completed' ? ' status-completed' : ''}`;
          // Keep in-memory state in sync if this is the loaded project
          if (state && state.slug === slug) state.status = status;
        } catch (e) {
          alert(`Failed to update status: ${e.message}`);
        }
      }

      // ─── Load project ───────────────────────────────────────────────────────
      async function loadProject(slug) {
        // Bug 1 fix: flush dirty state before switching away so badges stay in sync with disk
        if (isDirty) {
          if (autoSaveTimer) { clearTimeout(autoSaveTimer); autoSaveTimer = null; }
          await autoSave();
        } else if (autoSaveTimer) {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = null;
        }
        currentPage = null;
        currentSlug = slug;
        // Persist selection in URL so Vite HMR page-reloads don't bounce user to project-select
        history.replaceState({}, '', `?project=${encodeURIComponent(slug)}`);
        document.querySelectorAll('.project-btn').forEach(b => b.classList.toggle('active', b.dataset.slug === slug));
        studioMain.innerHTML = '<div class="loading">Loading…</div>';
        toolbarInline.style.display = '';

        // Blank-canvas: working set is exclusively what the sidecar says.
        // Photos are never auto-imported from disk — use "Add Photos" to add them.
        let saved = null;
        try { saved = await apiGet(`/sidecar/${slug}`); } catch {}

        // Folder listing, so the toolbar can offer photos that are on disk but
        // have never been imported onto the canvas.
        diskPhotos = { files: [], manifest: null };
        try {
          const d = await apiGet(`/photos/${slug}`);
          diskPhotos = { files: d.photos ?? [], manifest: d.manifest ?? null };
        } catch {}

        const savedPhotos = saved?.photos ?? [];
        const savedSeqOrder = (saved?.seqOrder ?? []).filter(fn => savedPhotos.some(p => p.filename === fn));

        state = {
          ...(saved ?? {}),
          slug,
          title: saved?.title ?? slugToTitle(slug),
          summary: saved?.summary ?? '',
          status: saved?.status ?? 'in-progress',
          draft: saved?.draft ?? false,
          heroFilename: saved?.heroFilename ?? null,
          specStrip: saved?.specStrip ?? [],
          photos: savedPhotos,
          seqOrder: savedSeqOrder,
        };

        isDirty = false;
        if (autoSaveTimer) { clearTimeout(autoSaveTimer); autoSaveTimer = null; }
        renderStudio();
        setSaveStatus('saved');
      }

      function slugToTitle(slug) {
        return slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }

      // ─── Add-photos flow ────────────────────────────────────────────────────
      function buildFileData(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onerror = reject;
          reader.onload = (e) => {
            const dataUrl = e.target.result;
            const img = new Image();
            img.onload = () => resolve({
              name: file.name,
              data: dataUrl,
              orientation: img.naturalHeight > img.naturalWidth ? 'portrait' : 'landscape',
            });
            img.onerror = () => resolve({ name: file.name, data: dataUrl, orientation: 'landscape' });
            img.src = dataUrl;
          };
          reader.readAsDataURL(file);
        });
      }

      /**
       * Pull photos that are already in the project folder onto the canvas.
       * They land as Unassigned with blank caption and alt, so nothing reaches
       * the published page until it has been written — the export skips any
       * photo without alt text.
       */
      function handleImportFromDisk() {
        if (!state) return;
        const onCanvas = new Set(state.photos.map(p => p.filename));
        const pending = diskPhotos.files.filter(fn => !onCanvas.has(fn));
        if (pending.length === 0) return;
        if (!confirm(`Import ${pending.length} photo(s) from the project folder?

They arrive as Unassigned with no caption or alt text.`)) return;

        // Orientation comes from the prepare-photos manifest when it is there,
        // so nothing has to be decoded in the browser just to place a photo.
        const dims = new Map(
          (diskPhotos.manifest?.photos ?? []).map(m => [m.new_filename, m])
        );
        for (const filename of pending) {
          const m = dims.get(filename);
          state.photos.push({
            filename,
            caption: '',
            alt: '',
            destination: 'unassigned',
            orientation: m && m.width < m.height ? 'portrait' : 'landscape',
          });
        }
        markDirty();
        renderStudio();
      }

      async function handleAddPhotos(files) {
        if (!currentSlug || !files.length) return;
        setSaveStatus('saving');
        try {
          const fileData = await Promise.all(Array.from(files).map(buildFileData));
          const r = await fetch('/api/studio/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: currentSlug, files: fileData }),
          });
          if (!r.ok) throw new Error(await r.text());
          const { uploaded } = await r.json();

          for (const { filename, originalName } of uploaded) {
            if (state.photos.some(p => p.filename === filename)) continue;
            const fd = fileData.find(f => f.name === originalName);
            state.photos.push({
              filename,
              caption: '',
              alt: '',
              destination: 'main',
              orientation: fd?.orientation ?? 'landscape',
            });
            state.seqOrder.push(filename);
          }

          markDirty();
          renderStudio();
        } catch (e) {
          setSaveStatus('unsaved');
          alert(`Upload failed: ${e.message}`);
        }
      }

      // ─── Render studio ──────────────────────────────────────────────────────
      function renderStudio() {
        if (!state) return;
        emptyState.style.display = 'none';

        const seqCount = state.seqOrder.length;
        const missingAlt = state.photos.filter(p =>
          (p.destination === 'main' || p.destination === 'gallery') && !p.alt.trim()
        ).length;
        const captionedCount = state.photos.filter(p => p.caption.trim()).length;
        const totalCount = state.photos.length;
        const wordCount = countWords(state.summary);
        const warnClass = wordCount > 35 ? 'warn' : '';
        const seqOnTarget = seqCount >= 12 && seqCount <= 24;

        // Build step groups (by chapter) for main sequence
        const seqPhotos = state.seqOrder.map(fn => state.photos.find(p => p.filename === fn)).filter(Boolean);
        const unassignedPhotos = state.photos.filter(p => p.destination === 'unassigned');
        const galleryPhotos = state.photos.filter(p => p.destination === 'gallery');
        const cutPhotos = state.photos.filter(p => p.destination === 'cut');
        // Photos sitting in the folder that the canvas has never taken in.
        const onCanvas = new Set(state.photos.map(p => p.filename));
        const pendingFromDisk = diskPhotos.files.filter(fn => !onCanvas.has(fn));

        studioMain.innerHTML = `
          <div class="toolbar">
            <div class="toolbar-group">
              <span style="font-size:10px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:0.06em">${escHtml(state.slug)}</span>
            </div>
            <div class="toolbar-sep"></div>
            <button class="btn btn-primary" id="btn-add-photos">+ Add Photos</button>
            ${pendingFromDisk.length > 0 ? `
              <button class="btn" id="btn-import-disk"
                title="${pendingFromDisk.length} photo(s) already in src/assets/photos/${escHtml(state.slug)}/ that are not on the canvas yet">
                &darr; Import ${pendingFromDisk.length} from folder
              </button>` : ''}
            <!-- EXTENSION POINT: Google Drive source — not yet implemented -->
            <button class="btn" id="btn-add-drive" disabled
              title="Google Drive import — coming soon"
              style="opacity:0.4;cursor:not-allowed">☁ Drive</button>
            <div class="toolbar-sep"></div>
            <span class="seq-counter${seqOnTarget ? ' on-target' : ''}" id="seq-counter">
              Seq: ${seqCount} <span style="opacity:0.5">/ 12–24</span>
            </span>
            <span class="seq-counter" id="captioned-counter" style="min-width:80px">
              ${captionedCount} <span style="opacity:0.5">/ ${totalCount} captioned</span>
            </span>
            <span class="missing-alt-badge${missingAlt > 0 ? ' visible' : ''}" id="missing-alt-badge">
              ${missingAlt} missing alt
            </span>
            <div class="toolbar-sep"></div>
            ${draftToggleHtml()}
            <button class="btn btn-primary" id="btn-save">Save</button>
            <button class="btn btn-primary" id="btn-export">Export MDX</button>
            <span id="save-status" class="save-status ${saveState}"${saveError ? ` title="Not written to disk: ${escHtml(saveError)}. Press Ctrl+S to retry."` : ''}>${SAVE_LABEL[saveState] ?? saveState}</span>
          </div>

          <div class="page-preview">
            <div class="page-col" id="photo-list">

              <div style="margin-bottom:2rem">
                <div class="page-header-area">
                  <div class="field-row">
                    <div class="field-label">
                      Summary
                      <span class="word-count ${warnClass}" id="word-count">${wordCount}/35 words</span>
                    </div>
                    <textarea
                      class="header-input" id="summary-input" rows="2"
                      placeholder="~30-word project summary…"
                    >${escHtml(state.summary)}</textarea>
                  </div>
                </div>
              </div>

              ${state.photos.length === 0 ? `
                <div class="blank-canvas-cta">
                  <h3>No photos yet</h3>
                  <p>Add photos from your computer to start building the sequence.</p>
                  <div class="add-source-row">
                    <button class="btn btn-primary btn-lg" id="btn-add-photos-empty">+ Add photos from computer</button>
                    <!-- EXTENSION POINT: Google Drive source — not yet implemented -->
                    <button class="btn btn-lg" disabled
                      title="Google Drive import — coming soon"
                      style="opacity:0.4;cursor:not-allowed">☁ From Drive (coming soon)</button>
                  </div>
                </div>
              ` : seqPhotos.length > 0 ? `
                <div class="preview-section-label">Main sequence — ${seqCount} steps</div>
                ${seqPhotos.map((photo, seqIdx) => renderStep(photo, seqIdx, 'main')).join('')}
              ` : `
                <div class="preview-section-label">No photos in main sequence yet</div>
              `}

              ${galleryPhotos.length > 0 ? `
                <div class="preview-section-label" style="margin-top:2.5rem">Gallery — ${galleryPhotos.length} photos</div>
                ${galleryPhotos.map((photo, i) => renderStep(photo, i, 'gallery')).join('')}
              ` : ''}

              ${unassignedPhotos.length > 0 ? `
                <div class="preview-section-label" style="margin-top:2.5rem">Unassigned — ${unassignedPhotos.length} photos</div>
                ${unassignedPhotos.map((photo, i) => renderStep(photo, i, 'unassigned')).join('')}
              ` : ''}

              ${cutPhotos.length > 0 ? `
                <button class="cut-section-toggle" id="cut-toggle" type="button">
                  ▸ Cut — ${cutPhotos.length} photos (hidden)
                </button>
                <div class="cut-list" id="cut-list">
                  ${cutPhotos.map((photo, i) => renderStep(photo, i, 'cut')).join('')}
                </div>
              ` : ''}

            </div>
          </div>
        `;

        bindEvents();
      }

      function renderStep(photo, displayIdx, section) {
        const masterIdx = state.photos.indexOf(photo);
        const imgSrc = `/photos/${currentSlug}/${photo.filename}`;
        const seqPos = state.seqOrder.indexOf(photo.filename);
        const isInSeq = seqPos >= 0;
        const isHero = state.heroFilename === photo.filename;
        const destClass = `dest-${photo.destination}`;
        const captionLen = photo.caption.length;
        const altLen = photo.alt.length;
        const captionWarn = captionLen > 90 ? 'warn' : '';
        const altMissing = (photo.destination === 'main' || photo.destination === 'gallery') && !photo.alt.trim();
        const seqFirst = isInSeq && seqPos === 0;
        const seqLast = isInSeq && seqPos === state.seqOrder.length - 1;
        const isPortrait = photo.orientation === 'portrait';

        return `
          <div class="step-block ${destClass}${isPortrait ? ' portrait' : ''}"
               data-filename="${escHtml(photo.filename)}" data-masteridx="${masterIdx}" draggable="true">

            <div class="step-controls">
              <span class="master-idx">#${masterIdx + 1}</span>

              <select class="dest-select ${destClass}" data-filename="${escHtml(photo.filename)}" aria-label="Destination">
                <option value="unassigned"${photo.destination === 'unassigned' ? ' selected' : ''}>Unassigned</option>
                <option value="main"${photo.destination === 'main' ? ' selected' : ''}>Main seq</option>
                <option value="gallery"${photo.destination === 'gallery' ? ' selected' : ''}>Gallery</option>
                <option value="cut"${photo.destination === 'cut' ? ' selected' : ''}>Cut</option>
              </select>

              <div class="seq-controls${isInSeq ? ' visible' : ''}">
                <span class="seq-pos-badge">#${isInSeq ? seqPos + 1 : '—'}</span>
                <button class="seq-btn" data-action="seq-up" data-filename="${escHtml(photo.filename)}"
                  ${seqFirst ? 'disabled' : ''} title="Move earlier">↑</button>
                <button class="seq-btn" data-action="seq-down" data-filename="${escHtml(photo.filename)}"
                  ${seqLast ? 'disabled' : ''} title="Move later">↓</button>
              </div>

              <label class="hero-label" title="Set as hero image">
                <input type="radio" name="hero-radio" value="${escHtml(photo.filename)}"${isHero ? ' checked' : ''} />
                ${isHero ? '★ Hero' : '☆ Hero'}
              </label>

              <span class="photo-filename">${escHtml(photo.filename)}</span>
              <span class="photo-save-indicator" id="save-ind-${masterIdx}"></span>
              <button class="btn-edit-photo" data-action="edit-photo" data-filename="${escHtml(photo.filename)}" title="Edit photo (crop, rotate, adjust)">✏</button>
              <button class="btn-delete" data-action="delete-photo" data-filename="${escHtml(photo.filename)}"
                title="Remove from canvas (does not delete file from disk)">×</button>
            </div>

            <div class="step-image-area">
              <img src="${imgSrc}" alt="${escHtml(photo.alt || photo.filename)}"
                   loading="lazy"
                   onerror="this.parentElement.innerHTML='<div class=\\'img-placeholder\\'>Image not found</div>'" />
            </div>

            <div class="step-caption-area">
              <textarea
                class="caption-input"
                data-filename="${escHtml(photo.filename)}"
                data-field="caption"
                placeholder="Caption for this photo…"
                maxlength="120"
                rows="1"
                aria-label="Caption for ${escHtml(photo.filename)}"
              >${escHtml(photo.caption)}</textarea>
              <div class="caption-meta">
                <span class="caption-field-label">
                  Caption
                  <span class="char-count ${captionWarn}" id="cap-count-${masterIdx}">${captionLen}/90</span>
                </span>
              </div>
            </div>

            <div class="alt-row">
              <div class="alt-field-label">
                Alt text
                <span class="char-count" id="alt-count-${masterIdx}">${altLen}/125</span>
              </div>
              <textarea
                class="alt-input"
                data-filename="${escHtml(photo.filename)}"
                data-field="alt"
                placeholder="Literal description of what is visible"
                maxlength="150"
                rows="1"
                aria-label="Alt text for ${escHtml(photo.filename)}"
              >${escHtml(photo.alt)}</textarea>
              <div class="alt-missing-warn${altMissing ? ' visible' : ''}">
                ⚠ Alt text required for export
              </div>
            </div>
          </div>
        `;
      }

      // ─── Bind all events (called after innerHTML write) ─────────────────────
      function bindEvents() {
        document.getElementById('btn-export')?.addEventListener('click', handleExport);

        // Edit-photo buttons
        document.querySelectorAll('[data-action="edit-photo"]').forEach(btn => {
          btn.addEventListener('click', () => openPhotoEditor(btn.dataset.filename));
        });
        document.getElementById('btn-save')?.addEventListener('click', () => autoSave());
        document.getElementById('btn-draft-toggle')?.addEventListener('click', toggleDraft);

        // Delete photo from canvas (does NOT remove file from disk)
        document.querySelectorAll('[data-action="delete-photo"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const fn = btn.dataset.filename;
            state.photos = state.photos.filter(p => p.filename !== fn);
            state.seqOrder = state.seqOrder.filter(f => f !== fn);
            if (state.heroFilename === fn) state.heroFilename = null;
            markDirty();
            renderStudio();
          });
        });

        // Add photos buttons (toolbar + blank-canvas CTA)
        const fileInput = document.getElementById('file-input');
        document.getElementById('btn-add-photos')?.addEventListener('click', () => fileInput?.click());
        document.getElementById('btn-import-disk')?.addEventListener('click', handleImportFromDisk);
        document.getElementById('btn-add-photos-empty')?.addEventListener('click', () => fileInput?.click());

        // Cut section toggle
        document.getElementById('cut-toggle')?.addEventListener('click', () => {
          const list = document.getElementById('cut-list');
          const btn = document.getElementById('cut-toggle');
          if (!list) return;
          list.classList.toggle('open');
          if (btn) btn.textContent = btn.textContent.replace(/[▸▾]/, list.classList.contains('open') ? '▾' : '▸');
        });

        // Summary
        const summaryInput = document.getElementById('summary-input');
        if (summaryInput) {
          summaryInput.addEventListener('input', () => {
            state.summary = summaryInput.value;
            const wc = countWords(state.summary);
            const wcEl = document.getElementById('word-count');
            if (wcEl) { wcEl.textContent = `${wc}/35 words`; wcEl.className = `word-count${wc > 35 ? ' warn' : ''}`; }
            markDirty();
          });
        }

        // Destination dropdowns
        document.querySelectorAll('.dest-select').forEach(sel => {
          sel.addEventListener('change', () => {
            const fn = sel.dataset.filename;
            const newDest = sel.value;
            const photo = state.photos.find(p => p.filename === fn);
            if (!photo) return;
            const oldDest = photo.destination;
            photo.destination = newDest;

            if (oldDest === 'main' && newDest !== 'main') {
              state.seqOrder = state.seqOrder.filter(f => f !== fn);
            }
            if (newDest === 'main' && !state.seqOrder.includes(fn)) {
              state.seqOrder.push(fn);
            }

            markDirty();
            renderStudio();
          });
        });

        // Up/down sequence buttons
        document.querySelectorAll('[data-action="seq-up"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const fn = btn.dataset.filename;
            const idx = state.seqOrder.indexOf(fn);
            if (idx <= 0) return;
            [state.seqOrder[idx - 1], state.seqOrder[idx]] = [state.seqOrder[idx], state.seqOrder[idx - 1]];
            markDirty();
            renderStudio();
          });
        });
        document.querySelectorAll('[data-action="seq-down"]').forEach(btn => {
          btn.addEventListener('click', () => {
            const fn = btn.dataset.filename;
            const idx = state.seqOrder.indexOf(fn);
            if (idx < 0 || idx >= state.seqOrder.length - 1) return;
            [state.seqOrder[idx], state.seqOrder[idx + 1]] = [state.seqOrder[idx + 1], state.seqOrder[idx]];
            markDirty();
            renderStudio();
          });
        });

        // Hero radio
        document.querySelectorAll('input[name="hero-radio"]').forEach(radio => {
          radio.addEventListener('change', () => {
            if (radio.checked) {
              state.heroFilename = radio.value;
              markDirty();
              document.querySelectorAll('.hero-label').forEach(lbl => {
                const r = lbl.querySelector('input');
                lbl.lastChild.textContent = r?.checked ? '★ Hero' : '☆ Hero';
              });
            }
          });
        });

        // Caption / alt inputs — delegated
        const photoList = document.getElementById('photo-list');
        if (photoList) {
          photoList.addEventListener('input', e => {
            const input = e.target;
            if (!input.dataset.filename || !input.dataset.field) return;
            const fn = input.dataset.filename;
            const field = input.dataset.field;
            const photo = state.photos.find(p => p.filename === fn);
            if (!photo) return;
            photo[field] = input.value;

            const masterIdx = state.photos.indexOf(photo);
            if (field === 'caption') {
              const el = document.getElementById(`cap-count-${masterIdx}`);
              if (el) { const l = input.value.length; el.textContent = `${l}/90`; el.className = `char-count${l > 90 ? ' warn' : ''}`; }
              updateCaptionedCounter();
            } else if (field === 'alt') {
              const el = document.getElementById(`alt-count-${masterIdx}`);
              if (el) { el.textContent = `${input.value.length}/125`; }
              const row = input.closest('.step-block');
              const warn = row?.querySelector('.alt-missing-warn');
              if (warn) {
                const p = state.photos.find(p => p.filename === fn);
                const needs = p && (p.destination === 'main' || p.destination === 'gallery');
                warn.classList.toggle('visible', needs && !input.value.trim());
              }
              updateMissingAltBadge();
            }

            markDirty(fn);
          });

          // Tab: caption → alt → next caption
          photoList.addEventListener('keydown', e => {
            if (e.key !== 'Tab' || e.shiftKey) return;
            const input = e.target;
            if (!input.dataset.filename || !input.dataset.field) return;
            if (input.dataset.field === 'caption') {
              e.preventDefault();
              const row = input.closest('.step-block');
              const altInput = row?.querySelector('.alt-input');
              if (altInput) altInput.focus();
            } else if (input.dataset.field === 'alt') {
              e.preventDefault();
              const fn = input.dataset.filename;
              const masterIdx = state.photos.findIndex(p => p.filename === fn);
              const nextIdx = masterIdx + 1;
              if (nextIdx < state.photos.length) {
                const nextFn = state.photos[nextIdx].filename;
                const nextCaption = photoList.querySelector(`[data-filename="${nextFn}"][data-field="caption"]`);
                if (nextCaption) nextCaption.focus();
              }
            }
          });

          // Auto-grow textareas
          photoList.querySelectorAll('.caption-input, .alt-input, .header-input').forEach(ta => {
            const grow = () => { ta.style.height = ''; ta.style.height = ta.scrollHeight + 'px'; };
            ta.addEventListener('input', grow);
            grow();
          });
        }

        // Drag-and-drop reorder
        const photoList2 = document.getElementById('photo-list');
        if (photoList2) {
          photoList2.addEventListener('dragstart', e => {
            const entry = e.target.closest('.step-block');
            if (!entry) return;
            dragSrcFn = entry.dataset.filename;
            e.dataTransfer.effectAllowed = 'move';
          });
          photoList2.addEventListener('dragover', e => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const entry = e.target.closest('.step-block');
            photoList2.querySelectorAll('.step-block').forEach(el => el.classList.remove('drag-over'));
            if (entry && entry.dataset.filename !== dragSrcFn) entry.classList.add('drag-over');
          });
          photoList2.addEventListener('dragleave', e => {
            const entry = e.target.closest('.step-block');
            if (entry) entry.classList.remove('drag-over');
          });
          photoList2.addEventListener('drop', e => {
            e.preventDefault();
            photoList2.querySelectorAll('.step-block').forEach(el => el.classList.remove('drag-over'));
            const entry = e.target.closest('.step-block');
            if (!entry || !dragSrcFn || entry.dataset.filename === dragSrcFn) return;
            const targetFn = entry.dataset.filename;
            const srcSeq = state.seqOrder.indexOf(dragSrcFn);
            const dstSeq = state.seqOrder.indexOf(targetFn);
            if (srcSeq >= 0 && dstSeq >= 0) {
              // Both in main sequence — reorder seqOrder (persists to JSON)
              state.seqOrder.splice(srcSeq, 1);
              state.seqOrder.splice(dstSeq, 0, dragSrcFn);
            } else {
              // Outside main sequence — reorder in master photos array
              const srcIdx = state.photos.findIndex(p => p.filename === dragSrcFn);
              const dstIdx = state.photos.findIndex(p => p.filename === targetFn);
              if (srcIdx < 0 || dstIdx < 0) return;
              const [moved] = state.photos.splice(srcIdx, 1);
              state.photos.splice(dstIdx, 0, moved);
            }
            markDirty();
            renderStudio();
            dragSrcFn = null;
          });
          photoList2.addEventListener('dragend', () => {
            photoList2.querySelectorAll('.step-block').forEach(el => el.classList.remove('drag-over'));
            dragSrcFn = null;
          });
        }
      }

      function updateMissingAltBadge() {
        const count = state.photos.filter(p =>
          (p.destination === 'main' || p.destination === 'gallery') && !p.alt.trim()
        ).length;
        const badge = document.getElementById('missing-alt-badge');
        if (badge) {
          badge.textContent = `${count} missing alt`;
          badge.classList.toggle('visible', count > 0);
        }
      }

      function updateCaptionedCounter() {
        const captioned = state.photos.filter(p => p.caption.trim()).length;
        const el = document.getElementById('captioned-counter');
        if (el) {
          el.innerHTML = `${captioned} <span style="opacity:0.5">/ ${state.photos.length} captioned</span>`;
        }
      }

      // ─── Save / autosave ────────────────────────────────────────────────────
      function markDirty(filename) {
        isDirty = true;
        if (filename) {
          dirtyPhotos.add(filename);
          const masterIdx = state.photos.findIndex(p => p.filename === filename);
          const ind = document.getElementById(`save-ind-${masterIdx}`);
          if (ind) { ind.textContent = '● unsaved'; ind.className = 'photo-save-indicator dirty'; }
        }
        // Manual-save model: edits mark the doc dirty, Ctrl+S writes it.
        // A failed write stays on screen until one succeeds — an edit on top of a
        // failure is still unsaved, so do not downgrade the message.
        if (saveState !== 'error') setSaveStatus('unsaved');
      }

      // ─── Live / Draft gate ──────────────────────────────────────────────────
      /**
       * `state.draft` is posted verbatim to the sidecar, and export-mdx.mjs
       * writes `draft: sidecar.draft ?? false` into the frontmatter. Every page
       * query (`index`, `projects/`, `skills/`, and both `[...slug]` routes)
       * filters on `!data.draft`, so a draft entry generates no route at all —
       * not a hidden page, no page. Flipping this is the whole publish gate.
       */
      function draftToggleHtml() {
        const isDraft = !!state.draft;
        const cls = isDraft ? 'is-draft' : 'is-live';
        const label = isDraft ? '◌ Draft' : '● Live';
        const title = isDraft
          ? 'Draft — hidden from the site. Click to publish.'
          : 'Live — visible on the site. Click to unpublish back to draft.';
        return `<button class="btn draft-toggle ${cls}" id="btn-draft-toggle" title="${title}" aria-pressed="${isDraft}">${label}</button>`;
      }

      /** Repaint one sidebar badge. No-op when that row is not rendered. */
      function syncDraftBadge(slug, isDraft) {
        if (!slug) return;
        const dot = projectList?.querySelector(`.project-draft[data-slug="${CSS.escape(slug)}"]`);
        if (!dot) return;
        dot.classList.toggle('is-draft', !!isDraft);
        dot.classList.toggle('is-live', !isDraft);
        dot.textContent = isDraft ? '◌' : '●';
        dot.title = isDraft
          ? `${slug} — Draft, hidden from the site`
          : `${slug} — Live on the site`;
      }

      function toggleDraft() {
        const goingLive = !!state.draft;
        state.draft = !state.draft;
        const btn = document.getElementById('btn-draft-toggle');
        if (btn) {
          btn.classList.toggle('is-draft', !!state.draft);
          btn.classList.toggle('is-live', !state.draft);
          btn.textContent = state.draft ? '◌ Draft' : '● Live';
          btn.setAttribute('aria-pressed', String(!!state.draft));
          btn.title = state.draft
            ? 'Draft — hidden from the site. Click to publish.'
            : 'Live — visible on the site. Click to unpublish back to draft.';
        }
        // Mirror the flip onto the sidebar badge immediately — the list must
        // never disagree with the entry that is open in front of you.
        syncDraftBadge(currentSlug, state.draft);
        isDirty = true;
        if (saveState !== 'error') setSaveStatus('unsaved');
        if (goingLive) {
          // Bug 2 fix: going Draft—Live saves in-memory state to disk first,
          // then exports MDX — prevents publishing blank/stale content.
          publishLive();
        } else {
          scheduleAutoSave();
        }
      }

      async function publishLive() {
        const persisted = await autoSave();
        if (!persisted) {
          alert(`Cannot publish — save failed (${saveError}). Fix the error and try again.`);
          return;
        }
        try {
          setSaveStatus('saving');
          const r = await fetch('/api/studio/export', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: state.slug }),
          });
          const data = await r.json();
          setSaveStatus('saved');
          if (!data.ok) {
            alert(`Saved as Live but MDX export failed: ${data.error}`);
          }
        } catch (e) {
          setSaveStatus('saved');
          console.warn('[studio] publishLive: export step failed:', e.message);
        }
      }

      const SAVE_LABEL = {
        saved: 'Saved',
        unsaved: '● Unsaved changes',
        saving: 'Saving…',
        error: '⚠ Save failed',
      };

      function setSaveStatus(s, error) {
        saveState = s;
        saveError = s === 'error' ? (error ?? 'Unknown error') : null;
        for (const id of ['save-status', 'save-status-header']) {
          const el = document.getElementById(id);
          if (!el) continue;
          el.className = `save-status ${s}`;
          el.textContent = SAVE_LABEL[s] ?? s;
          if (saveError) el.title = `Not written to disk: ${saveError}. Press Ctrl+S to retry.`;
          else el.removeAttribute('title');
        }
      }

      /** Persist shortly after an edit settles, so "Saved" means saved. */
      function scheduleAutoSave() {
        if (autoSaveTimer) clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => { autoSaveTimer = null; autoSave(); }, 1200);
      }

      /** @returns {Promise<boolean>} true only when the sidecar is on disk. */
      async function autoSave() {
        if (currentPage) return savePageContent();
        if (!state) return false;
        if (!isDirty) return saveState !== 'error';
        if (autoSaveTimer) { clearTimeout(autoSaveTimer); autoSaveTimer = null; }
        setSaveStatus('saving');
        try {
          const result = await apiPost(`/sidecar/${state.slug}`, state);
          // The endpoint answers {ok:true}. Anything else is not a confirmed write.
          if (!result?.ok) throw new Error(`Unexpected response: ${JSON.stringify(result)}`);
          isDirty = false;
          const saved = Array.from(dirtyPhotos);
          dirtyPhotos.clear();
          for (const fn of saved) {
            const masterIdx = state.photos.findIndex(p => p.filename === fn);
            const ind = document.getElementById(`save-ind-${masterIdx}`);
            if (ind) {
              ind.textContent = '✓ saved';
              ind.className = 'photo-save-indicator saved';
              setTimeout(() => { if (ind) ind.className = 'photo-save-indicator'; }, 2500);
            }
          }
          setSaveStatus('saved');
          return true;
        } catch (e) {
          // Never swallowed and never downgraded to a plain "unsaved": the edits
          // are still only in this tab, and the badge has to keep saying so.
          setSaveStatus('error', e?.message ?? String(e));
          console.error('Save failed:', e);
          return false;
        }
      }

      window.addEventListener('beforeunload', e => {
        if (isDirty) { e.preventDefault(); e.returnValue = ''; }
      });

      // Ctrl+S / Cmd+S — manual save
      window.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
          e.preventDefault();
          autoSave();
        }
      });

      // ─── Export ─────────────────────────────────────────────────────────────
      async function handleExport() {
        if (!state) return;
        // Warn if any photos are unassigned — they will NOT appear in the exported MDX
        const unassigned = state.photos.filter(p => p.destination === 'unassigned');
        if (unassigned.length > 0) {
          const names = unassigned.map(p => p.filename).join(', ');
          const ok = confirm(`${unassigned.length} photo(s) are unassigned and will NOT be included in the MDX:

${names}

Assign them to Main sequence, Gallery, or Cut first, or click OK to export anyway.`);
          if (!ok) return;
        }
        const persisted = await autoSave();
        if (!persisted) {
          alert(`Not exported — the save failed (${saveError}).\nThe exporter reads the sidecar from disk, so it would publish stale content.`);
          return;
        }
        try {
          const r = await fetch('/api/studio/export', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: state.slug }),
          });
          const data = await r.json();
          if (data.ok) { alert(`Exported to ${data.path}`); }
          else { alert(`Export failed: ${data.error}`); }
        } catch {
          alert(`Save complete. Run:\n  node scripts/export-mdx.mjs ${state.slug}`);
        }
      }

      // ─── Helpers ────────────────────────────────────────────────────────────
      function countWords(s) { return s.trim() ? s.trim().split(/\s+/).length : 0; }

      function escHtml(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // ─── Boot ───────────────────────────────────────────────────────────────
      // File input: bind once at boot (persists across renderStudio() calls)
      document.getElementById('file-input')?.addEventListener('change', e => {
        const input = /** @type {HTMLInputElement} */ (e.target);
        if (input.files?.length && currentSlug) {
          handleAddPhotos(input.files);
          input.value = ''; // reset so same files trigger again
        }
      });

      // ─── New-entry dialog ───────────────────────────────────────────────────
      // A project and a skill are the same editor over two collections, so the
      // only thing the dialog asks beyond the name is which one this is.
      const newEntryModal = document.getElementById('new-entry-modal');
      const newEntryName = document.getElementById('new-entry-name');
      const newEntryHint = document.getElementById('new-entry-hint');
      const newEntryErrorEl = document.getElementById('new-entry-error');
      const typeButtons = Array.from(document.querySelectorAll('#new-entry-type button'));
      let newEntryType = 'project';

      const TYPE_HINT = {
        project: 'Exports to src/content/projects/ &rarr; /projects/&lt;slug&gt;',
        skill: 'Exports to src/content/skills/ &rarr; /skills/&lt;slug&gt;',
      };

      function setNewEntryType(type) {
        newEntryType = type;
        for (const b of typeButtons) {
          b.setAttribute('aria-pressed', String(b.dataset.type === type));
        }
        newEntryHint.innerHTML = TYPE_HINT[type];
      }

      function showNewEntryError(msg) {
        newEntryErrorEl.textContent = msg;
        newEntryErrorEl.hidden = !msg;
      }

      function openNewEntry() {
        newEntryName.value = '';
        setNewEntryType('project');
        showNewEntryError('');
        newEntryModal.hidden = false;
        newEntryName.focus();
      }

      function closeNewEntry() {
        newEntryModal.hidden = true;
      }

      async function submitNewEntry() {
        const name = newEntryName.value.trim();
        if (!name) { showNewEntryError('Give it a name first.'); newEntryName.focus(); return; }
        const createBtn = document.getElementById('new-entry-create');
        createBtn.disabled = true;
        createBtn.textContent = 'Creating…';
        try {
          const r = await fetch('/api/studio/create-project', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, type: newEntryType }),
          });
          const data = await r.json();
          if (!r.ok) { showNewEntryError(data.error ?? 'Could not create it.'); return; }
          closeNewEntry();
          await loadProjects();
          loadProject(data.slug);
        } catch (e) {
          showNewEntryError(`Failed to create: ${e.message}`);
        } finally {
          createBtn.disabled = false;
          createBtn.textContent = 'Create';
        }
      }

      document.getElementById('btn-add-project')?.addEventListener('click', openNewEntry);
      document.getElementById('new-entry-cancel')?.addEventListener('click', closeNewEntry);
      document.getElementById('new-entry-create')?.addEventListener('click', submitNewEntry);
      for (const b of typeButtons) {
        b.addEventListener('click', () => setNewEntryType(b.dataset.type));
      }
      newEntryName?.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); submitNewEntry(); }
      });
      newEntryModal?.addEventListener('keydown', e => {
        if (e.key === 'Escape') { e.preventDefault(); closeNewEntry(); }
      });
      // Click-off closes, but only on the backdrop itself.
      newEntryModal?.addEventListener('click', e => {
        if (e.target === newEntryModal) closeNewEntry();
      });

      // ─── Publish to GitHub ──────────────────────────────────────────────────
      /** Last-fetched status payload from GET /api/studio/publish/status */
      let publishStatusData = null;

      async function refreshPublishStatus() {
        try {
          publishStatusData = await apiGet('/publish/status');
        } catch {
          publishStatusData = null;
        }
        const badge = document.getElementById('publish-count-badge');
        if (!badge) return;
        const count = publishStatusData?.count ?? 0;
        badge.textContent = String(count);
        badge.hidden = count === 0;
      }

      function openPublishModal() {
        const s = publishStatusData;
        if (!s) return;
        const modal = document.getElementById('publish-modal');
        const branchEl = document.getElementById('publish-modal-branch');
        const fileList = document.getElementById('publish-modal-file-list');
        const fileCount = document.getElementById('publish-modal-file-count');
        const behindWarn = document.getElementById('publish-behind-warn');
        const errorEl = document.getElementById('publish-modal-error');
        const msgInput = document.getElementById('publish-modal-msg');
        const confirmBtn = document.getElementById('publish-modal-confirm');

        if (branchEl) branchEl.textContent = s.branch || '—';
        if (fileCount) fileCount.textContent = `(${s.count ?? 0})`;
        if (behindWarn) behindWarn.hidden = !(s.behind > 0);
        if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
        if (msgInput) msgInput.value = '';
        if (confirmBtn) { confirmBtn.disabled = s.count === 0; confirmBtn.textContent = '↑ Push to GitHub'; }

        if (fileList) {
          if (!s.pending?.length) {
            fileList.innerHTML = '<li style="color:var(--muted)">No changes in allowed paths.</li>';
          } else {
            fileList.innerHTML = s.pending.map(f =>
              `<li><span class="file-xy">${escHtml(f.status)}</span>${escHtml(f.path)}</li>`
            ).join('');
          }
        }

        if (modal) modal.hidden = false;
      }

      function closePublishModal() {
        const modal = document.getElementById('publish-modal');
        if (modal) modal.hidden = true;
      }

      async function handlePublishConfirm() {
        const msgInput = document.getElementById('publish-modal-msg');
        const confirmBtn = document.getElementById('publish-modal-confirm');
        const errorEl = document.getElementById('publish-modal-error');
        const statusEl = document.getElementById('publish-inline-status');

        const message = msgInput?.value.trim() || '';
        if (confirmBtn) { confirmBtn.disabled = true; confirmBtn.textContent = '↑ Pushing…'; }
        if (errorEl) { errorEl.hidden = true; }
        if (statusEl) { statusEl.className = 'publish-inline-status pushing'; statusEl.textContent = 'Pushing…'; statusEl.hidden = false; }

        try {
          const r = await fetch('/api/studio/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message, dry_run: false }),
          });
          const result = await r.json();

          if (result.ok) {
            closePublishModal();
            if (statusEl) {
              statusEl.className = 'publish-inline-status success';
              statusEl.textContent = `✓ Pushed ${result.sha}`;
              statusEl.hidden = false;
              setTimeout(() => { statusEl.hidden = true; }, 10000);
            }
            await refreshPublishStatus();
          } else {
            if (errorEl) { errorEl.textContent = result.error || 'Publish failed'; errorEl.hidden = false; }
            if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.textContent = '↑ Push to GitHub'; }
            if (statusEl) {
              statusEl.className = 'publish-inline-status error';
              statusEl.textContent = '⚠ Push failed';
              statusEl.hidden = false;
              setTimeout(() => { statusEl.hidden = true; }, 8000);
            }
          }
        } catch (e) {
          if (errorEl) { errorEl.textContent = e.message || 'Unexpected error'; errorEl.hidden = false; }
          if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.textContent = '↑ Push to GitHub'; }
          if (statusEl) { statusEl.className = 'publish-inline-status error'; statusEl.textContent = '⚠ Error'; statusEl.hidden = false; }
        }
      }

      document.getElementById('btn-publish')?.addEventListener('click', async () => {
        // Warn if the active project has unassigned photos that would be silently dropped
        if (state) {
          const unassigned = state.photos.filter(p => p.destination === 'unassigned');
          if (unassigned.length > 0) {
            const names = unassigned.map(p => p.filename).join(', ');
            const ok = confirm(`⚠ ${unassigned.length} photo(s) in "${state.slug}" are unassigned and will NOT appear on the site after publish:

${names}

Click OK to publish anyway, or Cancel to assign them first.`);
            if (!ok) return;
          }
        }
        // Always fetch fresh status before opening modal.
        await refreshPublishStatus();
        openPublishModal();
      });
      document.getElementById('publish-modal-cancel')?.addEventListener('click', closePublishModal);
      document.getElementById('publish-modal-confirm')?.addEventListener('click', handlePublishConfirm);
      document.getElementById('publish-modal')?.addEventListener('click', e => {
        if (e.target === document.getElementById('publish-modal')) closePublishModal();
      });


      // ─── Photo Editor ──────────────────────────────────────────────────────────
      // Vanilla JS + Canvas. No external dependencies.
      // State is held in peState; crop coordinates are in canvas-native pixels.

      const peState = {
        filename: null,
        slug: null,
        img: null,
        rotation: 0,    // 0 | 90 | 180 | 270  (degrees CW)
        flipH: false,
        flipV: false,
        brightness: 1.0,
        contrast: 1.0,
        saturation: 1.0,
        // crop rect in canvas-native coordinates (after rotation/flip applied)
        crop: { x: 0, y: 0, w: 0, h: 0 },
        hasOriginal: false,
      };

      // Crop drag state
      let peDrag = null; // { handle: 'move'|'tl'|'tr'|'br'|'bl'|'t'|'r'|'b'|'l', startX, startY, startCrop }

      function peDisplaySize(img, rotation) {
        const sw = img.naturalWidth, sh = img.naturalHeight;
        return (rotation % 180 === 0) ? { w: sw, h: sh } : { w: sh, h: sw };
      }

      /** Render the image to pe-canvas with rotation/flip applied. */
      function peRenderPreview() {
        const { img, rotation, flipH, flipV, brightness, contrast, saturation } = peState;
        if (!img) return;
        const canvas = document.getElementById('pe-canvas');
        if (!canvas) return;
        const sw = img.naturalWidth, sh = img.naturalHeight;
        const { w: cw, h: ch } = peDisplaySize(img, rotation);
        canvas.width = cw;
        canvas.height = ch;
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, cw, ch);
        ctx.filter = `brightness(${brightness}) contrast(${contrast}) saturate(${saturation})`;
        ctx.save();
        ctx.translate(cw / 2, ch / 2);
        ctx.rotate(rotation * Math.PI / 180);
        if (flipH) ctx.scale(-1, 1);
        if (flipV) ctx.scale(1, -1);
        ctx.drawImage(img, -sw / 2, -sh / 2);
        ctx.restore();
        ctx.filter = 'none';
        peRenderCropOverlay();
      }

      /** Draw the crop rect on the transparent overlay canvas. */
      function peRenderCropOverlay() {
        const oCanvas = document.getElementById('pe-crop-canvas');
        const iCanvas = document.getElementById('pe-canvas');
        if (!oCanvas || !iCanvas) return;
        oCanvas.width = iCanvas.width;
        oCanvas.height = iCanvas.height;
        const ctx = oCanvas.getContext('2d');
        const { x, y, w, h } = peState.crop;
        const cw = oCanvas.width, ch = oCanvas.height;
        ctx.clearRect(0, 0, cw, ch);
        // Dark veil outside crop
        ctx.fillStyle = 'rgba(0,0,0,0.55)';
        ctx.fillRect(0, 0, cw, ch);
        ctx.clearRect(x, y, w, h);
        // Crop border
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
        // Rule-of-thirds grid
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.lineWidth = 0.5;
        for (let i = 1; i < 3; i++) {
          ctx.beginPath(); ctx.moveTo(x + w * i / 3, y); ctx.lineTo(x + w * i / 3, y + h); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(x, y + h * i / 3); ctx.lineTo(x + w, y + h * i / 3); ctx.stroke();
        }
        // Corner handles
        const hs = 7;
        ctx.fillStyle = '#fff';
        [[x, y], [x + w, y], [x + w, y + h], [x, y + h]].forEach(([hx, hy]) => {
          ctx.fillRect(hx - hs / 2, hy - hs / 2, hs, hs);
        });
        // Edge handles
        ctx.fillStyle = 'rgba(255,255,255,0.7)';
        [[x + w / 2, y], [x + w, y + h / 2], [x + w / 2, y + h], [x, y + h / 2]].forEach(([hx, hy]) => {
          ctx.fillRect(hx - hs / 2, hy - hs / 2, hs, hs);
        });
      }

      /** Convert a mouse event's client coords to canvas-native pixel coords. */
      function peClientToCrop(oCanvas, iCanvas, clientX, clientY) {
        const rect = oCanvas.getBoundingClientRect();
        const scaleX = iCanvas.width / rect.width;
        const scaleY = iCanvas.height / rect.height;
        return {
          x: (clientX - rect.left) * scaleX,
          y: (clientY - rect.top) * scaleY,
        };
      }

      const HIT = 10; // handle hit radius in canvas pixels (scale-adjusted)

      function peGetHandle(px, py) {
        const iCanvas = document.getElementById('pe-canvas');
        const oCanvas = document.getElementById('pe-crop-canvas');
        if (!iCanvas || !oCanvas) return null;
        const scaleX = iCanvas.width / oCanvas.getBoundingClientRect().width;
        const hitR = HIT * scaleX;
        const { x, y, w, h } = peState.crop;
        const near = (a, b) => Math.abs(a - b) <= hitR;
        if (near(px, x) && near(py, y)) return 'tl';
        if (near(px, x + w) && near(py, y)) return 'tr';
        if (near(px, x + w) && near(py, y + h)) return 'br';
        if (near(px, x) && near(py, y + h)) return 'bl';
        if (near(px, x + w / 2) && near(py, y)) return 't';
        if (near(px, x + w) && near(py, y + h / 2)) return 'r';
        if (near(px, x + w / 2) && near(py, y + h)) return 'b';
        if (near(px, x) && near(py, y + h / 2)) return 'l';
        if (px >= x && px <= x + w && py >= y && py <= y + h) return 'move';
        return null;
      }

      const MIN_CROP = 20;

      function peApplyDrag(curX, curY) {
        if (!peDrag) return;
        const dx = curX - peDrag.startX, dy = curY - peDrag.startY;
        const sc = { ...peDrag.startCrop };
        const iCanvas = document.getElementById('pe-canvas');
        if (!iCanvas) return;
        const imgW = iCanvas.width, imgH = iCanvas.height;
        let { x, y, w, h } = sc;
        switch (peDrag.handle) {
          case 'move':
            x = Math.max(0, Math.min(imgW - w, sc.x + dx));
            y = Math.max(0, Math.min(imgH - h, sc.y + dy));
            break;
          case 'tl':
            { const nx = Math.min(sc.x + dx, sc.x + sc.w - MIN_CROP);
              const ny = Math.min(sc.y + dy, sc.y + sc.h - MIN_CROP);
              w = sc.w + sc.x - Math.max(0, nx); h = sc.h + sc.y - Math.max(0, ny);
              x = sc.x + sc.w - w; y = sc.y + sc.h - h; } break;
          case 'tr':
            { const ny = Math.min(sc.y + dy, sc.y + sc.h - MIN_CROP);
              w = Math.max(MIN_CROP, Math.min(imgW - sc.x, sc.w + dx));
              h = sc.h + sc.y - Math.max(0, ny); y = sc.y + sc.h - h; } break;
          case 'br':
            w = Math.max(MIN_CROP, Math.min(imgW - sc.x, sc.w + dx));
            h = Math.max(MIN_CROP, Math.min(imgH - sc.y, sc.h + dy)); break;
          case 'bl':
            { const nx = Math.min(sc.x + dx, sc.x + sc.w - MIN_CROP);
              w = sc.w + sc.x - Math.max(0, nx); x = sc.x + sc.w - w;
              h = Math.max(MIN_CROP, Math.min(imgH - sc.y, sc.h + dy)); } break;
          case 't':
            { const ny = Math.min(sc.y + dy, sc.y + sc.h - MIN_CROP);
              h = sc.h + sc.y - Math.max(0, ny); y = sc.y + sc.h - h; } break;
          case 'r': w = Math.max(MIN_CROP, Math.min(imgW - sc.x, sc.w + dx)); break;
          case 'b': h = Math.max(MIN_CROP, Math.min(imgH - sc.y, sc.h + dy)); break;
          case 'l':
            { const nx = Math.min(sc.x + dx, sc.x + sc.w - MIN_CROP);
              w = sc.w + sc.x - Math.max(0, nx); x = sc.x + sc.w - w; } break;
        }
        peState.crop = { x: Math.max(0, x), y: Math.max(0, y), w: Math.max(MIN_CROP, w), h: Math.max(MIN_CROP, h) };
        peRenderCropOverlay();
      }

      function peCropCursorFor(handle) {
        const map = { tl: 'nwse-resize', tr: 'nesw-resize', br: 'nwse-resize', bl: 'nesw-resize', t: 'ns-resize', b: 'ns-resize', l: 'ew-resize', r: 'ew-resize', move: 'move' };
        return map[handle] || 'crosshair';
      }

      function peBindCropEvents() {
        const oCanvas = document.getElementById('pe-crop-canvas');
        const iCanvas = document.getElementById('pe-canvas');
        if (!oCanvas || !iCanvas) return;
        oCanvas.addEventListener('mousedown', e => {
          const { x, y } = peClientToCrop(oCanvas, iCanvas, e.clientX, e.clientY);
          const handle = peGetHandle(x, y);
          if (!handle) return;
          e.preventDefault();
          peDrag = { handle, startX: x, startY: y, startCrop: { ...peState.crop } };
        });
        window.addEventListener('mousemove', e => {
          if (!peDrag) {
            const { x, y } = peClientToCrop(oCanvas, iCanvas, e.clientX, e.clientY);
            const h = peGetHandle(x, y);
            oCanvas.style.cursor = h ? peCropCursorFor(h) : 'crosshair';
            return;
          }
          const { x, y } = peClientToCrop(oCanvas, iCanvas, e.clientX, e.clientY);
          peApplyDrag(x, y);
        });
        window.addEventListener('mouseup', () => { peDrag = null; });
        // Touch support
        oCanvas.addEventListener('touchstart', e => {
          const t = e.touches[0];
          const { x, y } = peClientToCrop(oCanvas, iCanvas, t.clientX, t.clientY);
          const handle = peGetHandle(x, y);
          if (!handle) return;
          e.preventDefault();
          peDrag = { handle, startX: x, startY: y, startCrop: { ...peState.crop } };
        }, { passive: false });
        window.addEventListener('touchmove', e => {
          if (!peDrag) return;
          const t = e.touches[0];
          const { x, y } = peClientToCrop(oCanvas, iCanvas, t.clientX, t.clientY);
          peApplyDrag(x, y);
        });
        window.addEventListener('touchend', () => { peDrag = null; });
      }

      function peResetCrop() {
        const iCanvas = document.getElementById('pe-canvas');
        if (!iCanvas) return;
        peState.crop = { x: 0, y: 0, w: iCanvas.width, h: iCanvas.height };
        peRenderCropOverlay();
      }

      async function openPhotoEditor(filename) {
        if (!currentSlug || !filename) return;
        peState.filename = filename;
        peState.slug = currentSlug;
        peState.rotation = 0;
        peState.flipH = false;
        peState.flipV = false;
        peState.brightness = 1.0;
        peState.contrast = 1.0;
        peState.saturation = 1.0;
        peState.hasOriginal = false;

        // Reset slider UI
        ['pe-bright','pe-contrast','pe-sat'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.value = '1.0';
        });
        document.getElementById('pe-bright-val') && (document.getElementById('pe-bright-val').textContent = '1.0');
        document.getElementById('pe-contrast-val') && (document.getElementById('pe-contrast-val').textContent = '1.0');
        document.getElementById('pe-sat-val') && (document.getElementById('pe-sat-val').textContent = '1.0');
        document.getElementById('pe-sat').value = '1.0';

        document.getElementById('pe-filename').textContent = filename;
        document.getElementById('pe-status').textContent = 'Loading…';
        document.getElementById('pe-original-badge').hidden = true;
        document.getElementById('pe-revert').hidden = true;
        document.getElementById('photo-editor-modal').hidden = false;

        // Load image
        const imgSrc = `/photos/${currentSlug}/${filename}?_nocache=${Date.now()}`;
        const img = new Image();
        img.crossOrigin = 'anonymous';
        await new Promise((resolve, reject) => {
          img.onload = resolve;
          img.onerror = reject;
          img.src = imgSrc;
        }).catch(() => {
          document.getElementById('pe-status').textContent = 'Failed to load image';
        });
        peState.img = img;
        document.getElementById('pe-status').textContent = '';

        // Check for existing original
        try {
          const r = await fetch(`/api/studio/has-original?slug=${encodeURIComponent(currentSlug)}&filename=${encodeURIComponent(filename)}`);
          const { exists } = await r.json();
          peState.hasOriginal = exists;
          document.getElementById('pe-original-badge').hidden = !exists;
          document.getElementById('pe-revert').hidden = !exists;
        } catch {}

        peRenderPreview();
        peResetCrop();
        peBindCropEvents();
      }

      function closePhotoEditor() {
        document.getElementById('photo-editor-modal').hidden = true;
        peState.img = null;
        peDrag = null;
      }

      /** Build final canvas with all edits applied (crop + rotation + flip + adjustments). */
      function peBuildFinalCanvas() {
        const { img, rotation, flipH, flipV, brightness, contrast, saturation, crop } = peState;
        if (!img) return null;
        const sw = img.naturalWidth, sh = img.naturalHeight;
        const { w: cw, h: ch } = peDisplaySize(img, rotation);
        // Draw full rotated/flipped image
        const full = document.createElement('canvas');
        full.width = cw; full.height = ch;
        const fctx = full.getContext('2d');
        fctx.filter = `brightness(${brightness}) contrast(${contrast}) saturate(${saturation})`;
        fctx.save();
        fctx.translate(cw / 2, ch / 2);
        fctx.rotate(rotation * Math.PI / 180);
        if (flipH) fctx.scale(-1, 1);
        if (flipV) fctx.scale(1, -1);
        fctx.drawImage(img, -sw / 2, -sh / 2);
        fctx.restore();
        // Crop
        const cx = Math.round(crop.x), cy = Math.round(crop.y);
        const cw2 = Math.max(1, Math.round(crop.w)), ch2 = Math.max(1, Math.round(crop.h));
        const out = document.createElement('canvas');
        out.width = cw2; out.height = ch2;
        out.getContext('2d').drawImage(full, cx, cy, cw2, ch2, 0, 0, cw2, ch2);
        return out;
      }

      async function saveEditedPhoto() {
        const btn = document.getElementById('pe-save');
        const statusEl = document.getElementById('pe-status');
        if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
        if (statusEl) statusEl.textContent = '';
        try {
          const finalCanvas = peBuildFinalCanvas();
          if (!finalCanvas) throw new Error('Could not build canvas');
          const dataUrl = await new Promise((resolve, reject) => {
            finalCanvas.toBlob(blob => {
              if (!blob) { reject(new Error('toBlob failed')); return; }
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result);
              reader.onerror = reject;
              reader.readAsDataURL(blob);
            }, 'image/jpeg', 0.92);
          });
          const r = await fetch('/api/studio/save-edited-photo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: peState.slug, filename: peState.filename, dataUrl }),
          });
          const result = await r.json();
          if (!result.ok) throw new Error(result.error || 'Save failed');
          // Show original badge/revert if server just created the backup
          if (result.hasOriginal) {
            peState.hasOriginal = true;
            document.getElementById('pe-original-badge').hidden = false;
            document.getElementById('pe-revert').hidden = false;
          }
          // Cache-bust the displayed image in the studio
          const ts = Date.now();
          document.querySelectorAll(`.step-block[data-filename="${CSS.escape(peState.filename)}"] img`).forEach(img => {
            img.src = `/photos/${peState.slug}/${peState.filename}?v=${ts}`;
          });
          if (statusEl) { statusEl.textContent = '✓ Saved'; setTimeout(() => { if (statusEl) statusEl.textContent = ''; }, 3000); }
          closePhotoEditor();
        } catch (e) {
          if (statusEl) statusEl.textContent = `⚠ ${e.message}`;
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = 'Save'; }
        }
      }

      async function revertPhoto() {
        if (!peState.hasOriginal) return;
        if (!confirm(`Revert "${peState.filename}" to its original? All edits will be lost.`)) return;
        const btn = document.getElementById('pe-revert');
        const statusEl = document.getElementById('pe-status');
        if (btn) { btn.disabled = true; btn.textContent = '↩ Reverting…'; }
        try {
          const r = await fetch('/api/studio/revert-photo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: peState.slug, filename: peState.filename }),
          });
          const result = await r.json();
          if (!result.ok) throw new Error(result.error || 'Revert failed');
          // Cache-bust display
          const ts = Date.now();
          document.querySelectorAll(`.step-block[data-filename="${CSS.escape(peState.filename)}"] img`).forEach(img => {
            img.src = `/photos/${peState.slug}/${peState.filename}?v=${ts}`;
          });
          if (statusEl) statusEl.textContent = '✓ Reverted';
          closePhotoEditor();
        } catch (e) {
          if (statusEl) statusEl.textContent = `⚠ ${e.message}`;
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = '↩ Revert'; }
        }
      }

      // Wire up photo editor modal controls (once at boot)
      document.getElementById('pe-cancel')?.addEventListener('click', closePhotoEditor);
      document.getElementById('photo-editor-modal')?.addEventListener('click', e => {
        if (e.target === document.getElementById('photo-editor-modal')) closePhotoEditor();
      });
      document.getElementById('pe-save')?.addEventListener('click', saveEditedPhoto);
      document.getElementById('pe-revert')?.addEventListener('click', revertPhoto);
      document.getElementById('pe-reset-crop')?.addEventListener('click', peResetCrop);

      document.getElementById('pe-rot-cw')?.addEventListener('click', () => {
        peState.rotation = (peState.rotation + 90) % 360;
        peRenderPreview(); peResetCrop();
      });
      document.getElementById('pe-rot-ccw')?.addEventListener('click', () => {
        peState.rotation = (peState.rotation + 270) % 360;
        peRenderPreview(); peResetCrop();
      });
      document.getElementById('pe-flip-h')?.addEventListener('click', () => {
        peState.flipH = !peState.flipH;
        peRenderPreview();
      });
      document.getElementById('pe-flip-v')?.addEventListener('click', () => {
        peState.flipV = !peState.flipV;
        peRenderPreview();
      });

      function peBindSlider(sliderId, valId, stateKey) {
        const slider = document.getElementById(sliderId);
        const valEl = document.getElementById(valId);
        if (!slider || !valEl) return;
        slider.addEventListener('input', () => {
          const v = parseFloat(slider.value);
          peState[stateKey] = v;
          valEl.textContent = v.toFixed(2);
          peRenderPreview();
        });
      }
      peBindSlider('pe-bright', 'pe-bright-val', 'brightness');
      peBindSlider('pe-contrast', 'pe-contrast-val', 'contrast');
      peBindSlider('pe-sat', 'pe-sat-val', 'saturation');

      // Escape key closes the editor
      window.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !document.getElementById('photo-editor-modal')?.hidden) {
          closePhotoEditor();
        }
      }, true);
      loadProjects();
      // Populate the badge at boot so the count is visible without clicking.
      refreshPublishStatus();
    </script>
  </body>
</html>
