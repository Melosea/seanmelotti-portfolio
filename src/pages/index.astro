---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Carousel from '../components/Carousel.astro';
import { resolveCover, coverAlt, PLACEHOLDER_COVER } from '../lib/photos';
import { SITE } from '../consts';

import homeContent from '../content/pages/home.json';

const { positioning: POSITIONING, tagline, ctaText, ctaSubtext, featuredProjects, featuredSkills } =
  homeContent;

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjectEntries = featuredProjects
  .map((slug) => allProjects.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);

const allSkills = await getCollection('skills', ({ data }) => !data.draft);
const featuredSkillEntries = featuredSkills
  .map((slug) => allSkills.find((s) => s.id === slug))
  .filter((s): s is NonNullable<typeof s> => s != null);

const projectCardProps = (project: (typeof allProjects)[number]) => ({
  title: project.data.title,
  summary: project.data.summary,
  image: resolveCover(project.data) ?? PLACEHOLDER_COVER,
  imageAlt: coverAlt(project.data),
  vehicle: project.data.vehicle,
  status: project.data.status,
  href: `/projects/${project.id}`,
});

const skillCardProps = (skill: (typeof allSkills)[number]) => ({
  title: skill.data.title,
  summary: skill.data.summary,
  image: resolveCover(skill.data) ?? PLACEHOLDER_COVER,
  imageAlt: coverAlt(skill.data),
  vehicle: skill.data.vehicle,
  href: `/skills/${skill.id}`,
});
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-hairline absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-canvas/60 to-canvas"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-8 md:py-14">
      <p class="hero-eyebrow">{POSITIONING}</p>

      <h1 class="mt-4 max-w-3xl text-4xl text-ink-950 md:text-5xl">Sean Melotti</h1>

      <p class="mt-4 max-w-xl text-base text-ink-500 md:text-lg">
        {tagline}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="/projects" class="btn btn-primary">View projects</a>
        <a href="/contact" class="btn btn-secondary">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- Featured projects carousel -->
  {
    featuredProjectEntries.length > 0 && (
      <section class="pt-8 pb-14 md:pt-12 md:pb-20" aria-labelledby="featured-projects">
        <div class="container-page">
          <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
            <h2 id="featured-projects" class="text-2xl text-ink-950 md:text-3xl">
              Featured projects
            </h2>
            <a href="/projects" class="link-accent text-sm">
              All projects &rarr;
            </a>
          </div>

          <div class="mt-5 md:mt-6 mx-5 md:mx-6">
            <Carousel label="Featured projects">
              {featuredProjectEntries.map((project) => (
                <li class="flex">
                  <ProjectCard {...projectCardProps(project)} eager />
                </li>
              ))}
            </Carousel>
          </div>
        </div>
      </section>
    )
  }

  <!-- Skills carousel -->
  {
    featuredSkillEntries.length > 0 && (
      <section
        class="pt-8 pb-14 md:pt-12 md:pb-20 border-t border-line"
        aria-labelledby="featured-skills"
      >
        <div class="container-page">
          <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
            <h2 id="featured-skills" class="text-2xl text-ink-950 md:text-3xl">
              Skills
            </h2>
            <a href="/skills" class="link-accent text-sm">
              All skills &rarr;
            </a>
          </div>

          <div class="mt-5 md:mt-6 mx-5 md:mx-6">
            <Carousel label="Skills">
              {featuredSkillEntries.map((skill) => (
                <li class="flex">
                  <ProjectCard {...skillCardProps(skill)} />
                </li>
              ))}
            </Carousel>
          </div>
        </div>
      </section>
    )
  }

  <!-- Closing CTA -->
  <section class="border-t border-line bg-surface">
    <div class="container-page py-14 md:py-16">
      <div class="flex flex-col items-center gap-5 text-center">
        <a href="/contact" class="cta-bubble">
          {ctaText}
          <svg
            class="h-4 w-4"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
          </svg>
        </a>
        <p class="text-sm text-ink-400">{ctaSubtext}</p>
      </div>
    </div>
  </section>
</BaseLayout>
