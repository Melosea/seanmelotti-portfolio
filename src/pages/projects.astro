---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageHeader from '../components/PageHeader.astro';

// Phase 2 adds per-project detail pages; until then cards render without a link.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Projects"
  description="Every project, documented — fabrication, engine work, restoration and the decisions behind each one."
>
  <PageHeader
    eyebrow="Portfolio"
    title="Projects"
    lede="Every project, documented from teardown to final fitment. Write-ups and photography are being added as the archive is digitised."
  />

  <section class="section">
    <div class="container-page">
      {
        projects.length > 0 ? (
          <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <li class="flex">
                <ProjectCard
                  title={project.data.title}
                  summary={project.data.summary}
                  image={project.data.coverImage}
                  imageAlt={
                    project.data.coverImageAlt ??
                    `Cover photo for ${project.data.title} (${project.data.vehicle})`
                  }
                  tags={project.data.tags}
                  vehicle={project.data.vehicle}
                  status={project.data.status}
                />
              </li>
            ))}
          </ul>
        ) : (
          <div class="rounded-lg border border-dashed border-line-strong bg-surface px-6 py-16 text-center">
            <p class="eyebrow">Nothing here yet</p>
            <p class="mx-auto mt-3 max-w-sm text-ink-500">
              Project write-ups are on the way. Check back shortly, or get in touch in the
              meantime.
            </p>
            <a href="/contact" class="btn btn-secondary mt-6">
              Get in touch
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
