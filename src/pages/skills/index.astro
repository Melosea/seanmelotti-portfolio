---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { resolveCover, coverAlt, PLACEHOLDER_COVER } from '../../lib/photos';
import skillsContent from '../../content/pages/skills.json';

const skills = (await getCollection('skills', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const heading = skillsContent?.heading || 'Skills';
const eyebrow = skillsContent?.eyebrow || 'Capabilities';
const lede = skillsContent?.lede || '';
const emptyHeading = skillsContent?.emptyHeading || 'Nothing here yet';
const emptyBody = skillsContent?.emptyBody || 'Capability pages are on the way.';
const emptyCtaText = skillsContent?.emptyCtaText || 'Browse projects';
---

<BaseLayout
  title={heading}
  description="What Sean Melotti can do, shown through the work — welding and fabrication, metal shaping, 3D modeling, additive manufacturing and finishing."
>
  <PageHeader
    eyebrow={eyebrow}
    title={heading}
    lede={lede || undefined}
  />

  <section class="section">
    <div class="container-page">
      {
        skills.length > 0 ? (
          <>
            <p class="eyebrow">
              {skills.length} {skills.length === 1 ? 'skill' : 'skills'}
            </p>
            <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {skills.map((skill, index) => (
                <li class="flex">
                  <ProjectCard
                    title={skill.data.title}
                    summary={skill.data.summary}
                    image={resolveCover(skill.data) ?? PLACEHOLDER_COVER}
                    imageAlt={coverAlt(skill.data)}
                    tags={skill.data.tags}
                    href={`/skills/${skill.id}`}
                    eager={index < 3}
                  />
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="rounded-lg border border-dashed border-line-strong bg-surface px-6 py-16 text-center">
            <p class="eyebrow">{emptyHeading}</p>
            <p class="mx-auto mt-3 max-w-sm text-ink-500">
              {emptyBody}
            </p>
            <a href="/projects" class="btn btn-secondary mt-6">
              {emptyCtaText}
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>