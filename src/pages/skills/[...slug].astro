---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { resolvePhoto, resolveCover, coverAlt, PLACEHOLDER_COVER } from '../../lib/photos';

export async function getStaticPaths() {
  const skills = await getCollection('skills', ({ data }) => !data.draft);
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const { Content } = await render(skill);

const getImg = resolvePhoto;

const { hero, specStrip, steps, gallery } = skill.data;

if (steps) {
  for (const step of steps) {
    if (step.caption.length > 90) {
      console.warn(`[${skill.id}] Caption >90 chars: "${step.caption.slice(0, 50)}..."`);
    }
  }
}

type StepWithImg = (typeof steps)[number] & { img: ImageMetadata | null; seqIdx: number };
const stepsWithImg: StepWithImg[] = (steps ?? []).map((s, i) => ({
  ...s,
  img: getImg(s.src),
  seqIdx: i,
}));

type ChapterGroup = { label: string | null; steps: StepWithImg[] };
const chapterGroups: ChapterGroup[] = [];
for (const step of stepsWithImg) {
  const chapter = step.chapter ?? null;
  const last = chapterGroups[chapterGroups.length - 1];
  if (!last || last.label !== chapter) {
    chapterGroups.push({ label: chapter, steps: [step] });
  } else {
    last.steps.push(step);
  }
}

// Chapter tabs: only show when at least one step has a named chapter
const uniqueChapters = [...new Set(stepsWithImg.map((s) => s.chapter).filter(Boolean))] as string[];
const hasChapterTabs = uniqueChapters.length > 0;
const hasOtherChapter = hasChapterTabs && stepsWithImg.some((s) => !s.chapter);
const tabChapters = hasOtherChapter ? [...uniqueChapters, 'Other'] : uniqueChapters;

const coverImg = resolveCover(skill.data);
const heroImg = (hero ? getImg(hero.src) : null) ?? coverImg;

const ogImage = coverImg
  ? (await getImage({ src: coverImg, width: 1200, format: 'jpeg' })).src
  : undefined;
const useNewLayout = !!hero;
---

<BaseLayout
  title={skill.data.title}
  description={skill.data.summary}
  image={ogImage}
>
  <article>
    {useNewLayout ? (
      <>
        <div class="hero-wrap">
          <div class="hero-photo">
            {heroImg ? (
              <Image
                src={heroImg}
                alt={hero!.alt}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                widths={[640, 960, 1440, 1920]}
                sizes="100vw"
                class="hero-img"
              />
            ) : (
              <img
                src={PLACEHOLDER_COVER}
                alt={hero!.alt}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class="hero-img"
              />
            )}
          </div>
          <div class="hero-band">
            <div class="container-narrow">
              <a href="/skills" class="link-accent text-sm">&larr; All skills</a>
              <p class="eyebrow mt-6">Skill &middot; Portfolio</p>
              <h1 class="mt-2 text-4xl text-ink-950">{skill.data.title}</h1>
              <p class="mt-4 text-xl text-ink-700">{skill.data.summary}</p>
              {specStrip && specStrip.length > 0 && (
                <p class="hero-spec-strip">{specStrip.join(' · ')}</p>
              )}
              <div class="mt-5 flex flex-wrap items-center gap-2">
                {skill.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </div>
        </div>

        {stepsWithImg.length > 0 && (
          <div class="seq-section">
            <div class:list={[hasChapterTabs ? 'chapter-layout' : '']}>
              {hasChapterTabs && (
                <nav class="chapter-tabs" aria-label="Chapters">
                  <button class="chapter-tab is-active" data-filter="__all">All</button>
                  {tabChapters.map((ch) => (
                    <button class="chapter-tab" data-filter={ch === 'Other' ? '__other' : ch}>{ch}</button>
                  ))}
                </nav>
              )}
              <div class="seq-list">
                {chapterGroups.map((group) => (
                  <div
                    class:list={['seq-chapter-group', group.label ? 'seq-chapter-break' : '']}
                    data-chapter={group.label ?? '__other'}
                  >
                    {group.label && (
                      <p class="seq-chapter">{group.label}</p>
                    )}
                    {(() => {
                      const rendered: any[] = [];
                      let i = 0;
                      while (i < group.steps.length) {
                        const step = group.steps[i];
                        if (i === 0) {
                          rendered.push(
                            <figure class:list={['seq-figure', step.orientation === 'portrait' ? 'portrait' : '']} key={`step-${step.seqIdx}`}>
                              {step.img ? (
                                <Image src={step.img} alt={step.alt} loading="lazy" decoding="async"
                                  widths={[480, 880, 1760]} sizes="(min-width: 72rem) 880px, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)" />
                              ) : null}
                              {step.caption && <figcaption class="seq-caption">{step.caption}</figcaption>}
                            </figure>
                          );
                          i++;
                        } else {
                          const nextStep = group.steps[i + 1];
                          if (nextStep) {
                            rendered.push(
                              <div class="seq-pair" key={`pair-${step.seqIdx}`}>
                                <figure class:list={['seq-figure', step.orientation === 'portrait' ? 'portrait' : '']}>
                                  {step.img ? (
                                    <Image src={step.img} alt={step.alt} loading="lazy" decoding="async"
                                      widths={[320, 640, 880]} sizes="(min-width: 72rem) 430px, (min-width: 48rem) calc(50vw - 2rem), calc(100vw - 2.5rem)" />
                                  ) : null}
                                  {step.caption && <figcaption class="seq-caption">{step.caption}</figcaption>}
                                </figure>
                                <figure class:list={['seq-figure', nextStep.orientation === 'portrait' ? 'portrait' : '']}>
                                  {nextStep.img ? (
                                    <Image src={nextStep.img} alt={nextStep.alt} loading="lazy" decoding="async"
                                      widths={[320, 640, 880]} sizes="(min-width: 72rem) 430px, (min-width: 48rem) calc(50vw - 2rem), calc(100vw - 2.5rem)" />
                                  ) : null}
                                  {nextStep.caption && <figcaption class="seq-caption">{nextStep.caption}</figcaption>}
                                </figure>
                              </div>
                            );
                            i += 2;
                          } else {
                            rendered.push(
                              <figure class:list={['seq-figure', step.orientation === 'portrait' ? 'portrait' : '']} key={`step-${step.seqIdx}`}>
                                {step.img ? (
                                  <Image src={step.img} alt={step.alt} loading="lazy" decoding="async"
                                    widths={[320, 640, 880]} sizes="(min-width: 72rem) 430px, (min-width: 48rem) calc(50vw - 2rem), calc(100vw - 2.5rem)" />
                                ) : null}
                                {step.caption && <figcaption class="seq-caption">{step.caption}</figcaption>}
                              </figure>
                            );
                            i++;
                          }
                        }
                      }
                      return rendered;
                    })()}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {gallery && gallery.length > 0 && (
          <div class="gallery-section">
            <h2 class="gallery-heading">Full gallery &mdash; {gallery.length} photos</h2>
            <div class="gallery-grid">
              {gallery.map((item) => {
                const img = getImg(item.src);
                return img ? (
                  <Image src={img} alt={item.alt} loading="lazy" decoding="async"
                    widths={[320, 680]} sizes="(min-width: 72rem) 340px, 50vw" />
                ) : null;
              })}
            </div>
          </div>
        )}

        <div class="seq-section" style="padding-top: 0;">
          <div class="container-narrow mx-0">
            <a href="/contact" class="cta-bubble">
              Let&rsquo;s have a conversation
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
              </svg>
            </a>
          </div>
        </div>

        <Lightbox />
      </>
    ) : (
      <>
        <div class="border-b border-line bg-surface">
          <div class="container-narrow py-12 md:py-16">
            <a href="/skills" class="link-accent text-sm">&larr; All skills</a>
            <p class="eyebrow mt-8">Skill &middot; Portfolio</p>
            <h1 class="mt-3 text-3xl text-ink-950 md:text-4xl">{skill.data.title}</h1>
            <p class="mt-4 text-lg text-ink-500">{skill.data.summary}</p>
            <div class="mt-6 flex flex-wrap items-center gap-2">
              {skill.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </div>
        <div class="container-narrow py-12 md:py-16">
          {coverImg ? (
            <Image
              src={coverImg}
              alt={coverAlt(skill.data)}
              widths={[640, 960, 1440]}
              sizes="(min-width: 48rem) 720px, 100vw"
              class="w-full rounded-lg border border-line bg-surface-sunken"
            />
          ) : (
            <img
              src={PLACEHOLDER_COVER}
              alt={coverAlt(skill.data)}
              width="800"
              height="500"
              class="w-full rounded-lg border border-line bg-surface-sunken"
            />
          )}
          <div class="photo-column mt-10">
            <Content />
          </div>
          <div class="mt-14 border-t border-line pt-8">
            <a href="/contact" class="cta-bubble">
              Let&rsquo;s have a conversation
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </>
    )}
  </article>
</BaseLayout>

<script>
  const nav = document.querySelector<HTMLElement>('.chapter-tabs');
  if (nav) {
    const layout = nav.parentElement;
    const seqList = layout?.querySelector<HTMLElement>('.seq-list');
    if (seqList) {
      nav.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('.chapter-tab');
        if (!btn) return;
        const filter = btn.dataset.filter!;
        nav.querySelectorAll('.chapter-tab').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        seqList.querySelectorAll<HTMLElement>('[data-chapter]').forEach((g) => {
          g.hidden = filter !== '__all' && g.dataset.chapter !== filter;
        });
      });
    }
  }
</script>
