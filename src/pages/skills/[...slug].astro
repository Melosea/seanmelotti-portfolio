---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const skills = await getCollection('skills', ({ data }) => !data.draft);
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const { Content } = await render(skill);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP}',
  { eager: true }
);

function getImg(slugSlashFile: string): ImageMetadata | null {
  const key = `/src/assets/photos/${slugSlashFile}`;
  return allImages[key]?.default ?? null;
}

const { hero, specStrip, steps, gallery } = skill.data;

if (steps) {
  for (const step of steps) {
    if (step.caption.length > 90) {
      console.warn(`[${skill.id}] Caption >90 chars: "${step.caption.slice(0, 50)}..."`);
    }
  }
}

type StepWithImg = (typeof steps)[number] & { img: ImageMetadata | null; seqIdx: number };
const stepsWithImg: StepWithImg[] = (steps ?? []).map((s, i) => ({
  ...s,
  img: getImg(s.src),
  seqIdx: i,
}));

type ChapterGroup = { label: string | null; steps: StepWithImg[] };
const chapterGroups: ChapterGroup[] = [];
for (const step of stepsWithImg) {
  const chapter = step.chapter ?? null;
  const last = chapterGroups[chapterGroups.length - 1];
  if (!last || last.label !== chapter) {
    chapterGroups.push({ label: chapter, steps: [step] });
  } else {
    last.steps.push(step);
  }
}

const heroImg = hero ? getImg(hero.src) : null;
const useNewLayout = !!hero;
---

<BaseLayout
  title={skill.data.title}
  description={skill.data.summary}
  image={skill.data.coverImage}
>
  <article>
    {useNewLayout ? (
      <>
        <div class="hero-wrap">
          <div class="hero-photo">
            {heroImg ? (
              <Image
                src={heroImg}
                alt={hero!.alt}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                widths={[640, 960, 1440, 1920]}
                sizes="100vw"
                class="hero-img"
              />
            ) : (
              <img
                src={`/photos/${skill.id}/${hero!.src.split('/').pop()}`}
                alt={hero!.alt}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class="hero-img"
              />
            )}
          </div>
          <div class="hero-band">
            <div class="container-narrow">
              <a href="/projects" class="link-accent text-sm">&larr; All projects</a>
              <p class="eyebrow mt-6">Skill &middot; Portfolio</p>
              <h1 class="mt-2 text-4xl text-ink-950">{skill.data.title}</h1>
              <p class="mt-4 text-xl text-ink-700">{skill.data.summary}</p>
              {specStrip && specStrip.length > 0 && (
                <p class="hero-spec-strip">{specStrip.join(' · ')}</p>
              )}
              <div class="mt-5 flex flex-wrap items-center gap-2">
                {skill.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </div>
        </div>

        {stepsWithImg.length > 0 && (
          <div class="seq-section">
            <div class="seq-list">
              {chapterGroups.map((group) => (
                <div class:list={['seq-chapter-group', group.label ? 'seq-chapter-break' : '']}>
                  {group.label && (
                    <p class="seq-chapter">{group.label}</p>
                  )}
                  {(() => {
                    const rendered: any[] = [];
                    let i = 0;
                    while (i < group.steps.length) {
                      const step = group.steps[i];
                      const nextStep = group.steps[i + 1];
                      if (step.pair && nextStep?.pair) {
                        rendered.push(
                          <div class="seq-pair" key={`pair-${step.seqIdx}`}>
                            <figure class:list={['seq-figure', step.orientation === 'portrait' ? 'portrait' : '']}>
                              {step.img ? (
                                <Image src={step.img} alt={step.alt} loading="lazy" decoding="async"
                                  widths={[640, 960, 1440, 1920]} sizes="(min-width: 72rem) 576px, 50vw" />
                              ) : null}
                              {step.caption && <figcaption class="seq-caption">{step.caption}</figcaption>}
                            </figure>
                            <figure class:list={['seq-figure', nextStep.orientation === 'portrait' ? 'portrait' : '']}>
                              {nextStep.img ? (
                                <Image src={nextStep.img} alt={nextStep.alt} loading="lazy" decoding="async"
                                  widths={[640, 960, 1440, 1920]} sizes="(min-width: 72rem) 576px, 50vw" />
                              ) : null}
                              {nextStep.caption && <figcaption class="seq-caption">{nextStep.caption}</figcaption>}
                            </figure>
                          </div>
                        );
                        i += 2;
                      } else {
                        rendered.push(
                          <figure class:list={['seq-figure', step.orientation === 'portrait' ? 'portrait' : '']} key={`step-${step.seqIdx}`}>
                            {step.img ? (
                              <Image src={step.img} alt={step.alt} loading="lazy" decoding="async"
                                widths={[640, 960, 1440, 1920]} sizes="(min-width: 72rem) 1152px, 100vw" />
                            ) : null}
                            {step.caption && <figcaption class="seq-caption">{step.caption}</figcaption>}
                          </figure>
                        );
                        i++;
                      }
                    }
                    return rendered;
                  })()}
                </div>
              ))}
            </div>
          </div>
        )}

        {gallery && gallery.length > 0 && (
          <div class="gallery-section">
            <details>
              <summary>
                <svg class="inline-block" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 5l6 6 6-6"/>
                </svg>
                Full gallery — {gallery.length} photos
              </summary>
              <div class="gallery-grid">
                {gallery.map((item) => {
                  const img = getImg(item.src);
                  return img ? (
                    <Image src={img} alt={item.alt} loading="lazy" decoding="async"
                      widths={[400, 800]} sizes="(min-width: 72rem) 260px, 50vw" />
                  ) : null;
                })}
              </div>
            </details>
          </div>
        )}

        <div class="seq-section" style="padding-top: 0;">
          <div class="container-narrow mx-0">
            <a href="/contact" class="cta-bubble">
              Let&rsquo;s have a conversation
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </>
    ) : (
      <>
        <div class="border-b border-line bg-surface">
          <div class="container-narrow py-12 md:py-16">
            <a href="/projects" class="link-accent text-sm">&larr; All projects</a>
            <p class="eyebrow mt-8">Skill &middot; Portfolio</p>
            <h1 class="mt-3 text-3xl text-ink-950 md:text-4xl">{skill.data.title}</h1>
            <p class="mt-4 text-lg text-ink-500">{skill.data.summary}</p>
            <div class="mt-6 flex flex-wrap items-center gap-2">
              {skill.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </div>
        <div class="container-narrow py-12 md:py-16">
          <img
            src={skill.data.coverImage}
            alt={skill.data.coverImageAlt ?? `Cover photo for ${skill.data.title}`}
            width="800"
            height="500"
            class="w-full rounded-lg border border-line bg-surface-sunken"
          />
          <div class="photo-column mt-10">
            <Content />
          </div>
          <div class="mt-14 border-t border-line pt-8">
            <a href="/contact" class="cta-bubble">
              Let&rsquo;s have a conversation
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
              </svg>
            </a>
          </div>
        </div>
      </>
    )}
  </article>
</BaseLayout>
