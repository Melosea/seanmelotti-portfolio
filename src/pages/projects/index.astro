---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { resolveCover, coverAlt, PLACEHOLDER_COVER } from '../../lib/photos';
import { formatDateLabel } from '../../lib/date-label.mjs';
import projectsContent from '../../content/pages/projects.json';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const heading = projectsContent?.heading || 'Projects';
const eyebrow = projectsContent?.eyebrow || 'Archive';
const lede = projectsContent?.lede || '';
const emptyHeading = projectsContent?.emptyHeading || 'Nothing here yet';
const emptyBody = projectsContent?.emptyBody || 'Project write-ups are on the way.';
const emptyCtaText = projectsContent?.emptyCtaText || 'Get in touch';
---

<BaseLayout
  title={heading}
  description="The full archive of Sean Melotti's projects — mechanical restoration, fabrication, 3D modeling and additive manufacturing, newest first."
>
  <PageHeader
    eyebrow={eyebrow}
    title={heading}
    lede={lede || undefined}
  />

  <section class="section">
    <div class="container-page">
      {
        projects.length > 0 ? (
          <>
            <p class="eyebrow">
              {projects.length} {projects.length === 1 ? 'project' : 'projects'}
            </p>
            <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {projects.map((project, index) => (
                <li class="flex">
                  <ProjectCard
                    title={project.data.title}
                    summary={project.data.summary}
                    image={resolveCover(project.data) ?? PLACEHOLDER_COVER}
                    imageAlt={coverAlt(project.data)}
                    tags={project.data.tags}
                    dateLabel={formatDateLabel(project.data)}
                    status={project.data.status}
                    href={`/projects/${project.id}`}
                    eager={index < 3}
                  />
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="rounded-lg border border-dashed border-line-strong bg-surface px-6 py-16 text-center">
            <p class="eyebrow">{emptyHeading}</p>
            <p class="mx-auto mt-3 max-w-sm text-ink-500">
              {emptyBody}
            </p>
            <a href="/contact" class="btn btn-secondary mt-6">
              {emptyCtaText}
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>