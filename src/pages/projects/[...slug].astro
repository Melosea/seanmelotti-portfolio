---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const STATUS_LABEL = {
  complete: 'Complete',
  'in-progress': 'In progress',
  planned: 'Planned',
} as const;

const STATUS_CLASS = {
  complete: 'status-pill-complete',
  'in-progress': 'status-pill-progress',
  planned: 'status-pill-planned',
} as const;

const fullDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(project.data.date);
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  image={project.data.coverImage}
>
  <article>
    <div class="border-b border-line bg-surface">
      <div class="container-narrow py-12 md:py-16">
        <a href="/projects" class="link-accent text-sm">&larr; All projects</a>

        <p class="eyebrow mt-8">{project.data.vehicle} &middot; {fullDate}</p>
        <h1 class="mt-3 text-3xl text-ink-950 md:text-4xl">{project.data.title}</h1>
        <p class="mt-4 text-lg text-ink-500">{project.data.summary}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class:list={['status-pill', STATUS_CLASS[project.data.status]]}>
            {STATUS_LABEL[project.data.status]}
          </span>
          {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    </div>

    <div class="container-narrow py-12 md:py-16">
      <img
        src={project.data.coverImage}
        alt={project.data.coverImageAlt ??
          `Cover photo for ${project.data.title} (${project.data.vehicle})`}
        width="800"
        height="500"
        class="w-full rounded-lg border border-line bg-surface-sunken"
      />

      <div class="prose-page mt-10">
        <Content />
      </div>

      <div class="mt-14 border-t border-line pt-8">
        <a href="/contact" class="cta-bubble">
          Let&rsquo;s have a conversation
          <svg
            class="h-4 w-4"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5"></path>
          </svg>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
