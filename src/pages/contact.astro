---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SOCIAL_LINKS } from '../consts';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Sean Melotti about a build, a commission or a collaboration."
>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    lede="Placeholder lede — tell people what to send and what to expect back."
  />

  <section class="section">
    <div class="container-narrow">
      <p class="text-lg text-ink-500">
        Placeholder copy. The quickest route is email — a few lines on the vehicle, the
        scope and your timeline is plenty to start.
      </p>

      <ul class="mt-10 divide-y divide-line border-y border-line">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                class="group flex flex-col gap-1 py-4 transition-colors hover:text-ink-900 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
                rel={social.href.startsWith('http') ? 'me noopener' : undefined}
              >
                <span class="text-sm font-[540] text-ink-900">{social.label}</span>
                <span class="font-mono text-xs break-all text-ink-400 transition-colors group-hover:text-accent">
                  {social.handle}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-8 text-sm text-ink-400">
        A contact form may land in a later phase — for now these links are placeholders
        pending Sean's real handles.
      </p>
    </div>
  </section>
</BaseLayout>
