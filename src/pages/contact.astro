---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import contactContent from '../content/pages/contact.json';

const { heading, lede, contactMethods, footerNote } = contactContent;

const isPhone = (href: string) => href.startsWith('tel:');
---

<BaseLayout
  title="Contact"
  description="Get in touch with Sean Melotti about a project, a commission or a collaboration. Email seancmelotti@gmail.com."
>
  <PageHeader
    eyebrow="Contact"
    title={heading}
    lede={lede}
  />

  <section class="section">
    <div class="container-page">
      <ul class="flex max-w-2xl flex-col gap-4">
        {
          contactMethods.map((method) => (
            <li>
              <a href={method.href} class="contact-card">
                <span class="contact-card-label">{method.label}</span>
                <span
                  class:list={[
                    'contact-card-value',
                    isPhone(method.href) && 'contact-card-value-phone',
                  ]}
                >
                  {method.value}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 max-w-2xl text-base text-ink-500">
        {footerNote}
      </p>
    </div>
  </section>
</BaseLayout>
