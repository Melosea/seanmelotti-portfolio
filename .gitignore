# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Large binary download staging area
src/assets/photos/Portfolio*/
missing_files.json

# Cerebro agent runtime (scripts + durable notes ARE tracked; runtime output is not)
.cerebro-tools/autosave.log
.cerebro-tools/*.pid
.cerebro-tools/__pycache__/
.cerebro-tools/screenshots/
.cerebro-tools/mission-records/
# Transient agent handoff docs (build->QA). Durable notes like FUTURE-WORK.md stay tracked.
.cerebro-tools/READY-FOR-QA.md
.cerebro-tools/QA-REPORT.md

# Dev server logs (agent-launched astro dev)
.dev-server.log
.dev-server-err.log
